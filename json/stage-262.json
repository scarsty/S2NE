  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 155,
          "name": "造型魔頭",
          "text": "....報告，又有無聊的玩家上門挑戰了。"
        },
        {
          "speaker": 157,
          "name": "效果魔頭",
          "text": "煩不煩啊，每次都來打擾進度，真是找碴！"
        },
        {
          "speaker": 156,
          "name": "大魔頭",
          "text": "....上次還搶走我的棒棒糖，這次絕不能輕饒這些臭玩家！"
        },
        {
          "speaker": 158,
          "name": "程式魔頭",
          "text": "贊成，我要痛扁這些沒事愛找隱關的傢伙！"
        },
        {
          "speaker": 159,
          "name": "企劃魔頭",
          "text": "這次我們可是變得難纏多喔，嘿嘿嘿....。"
        },
        {
          "speaker": 149,
          "name": "插花魔頭",
          "text": "預告....預告....新遊戲@@WA7,00D3D@@古文明霸王傳@@RWRD@@即將在七月上市，敬請期待....。"
        },
        {
          "speaker": 157,
          "name": "效果魔頭",
          "text": "喂，另一組的，沒事不要來插花....。"
        },
        {
          "speaker": 155,
          "name": "造型魔頭",
          "text": "對嘛，快回去趕進度！"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 155,
      "lines": [
        {
          "speaker": 155,
          "name": "造型魔頭",
          "text": "什麼？這樣還會輸....？"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 157,
      "lines": [
        {
          "speaker": 157,
          "name": "效果魔頭",
          "text": "....升天了....升天了....。"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 156,
      "lines": [
        {
          "speaker": 156,
          "name": "大魔頭",
          "text": "哇....連法寶都被炸掉了！"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 158,
      "lines": [
        {
          "speaker": 158,
          "name": "程式魔頭",
          "text": "又輸了，下次要改成不死身！"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 159,
      "lines": [
        {
          "speaker": 159,
          "name": "企劃魔頭",
          "text": "怎麼還會這樣....你沒有用ＦＰＥ吧？"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 149,
      "lines": [
        {
          "speaker": 149,
          "name": "插花魔頭",
          "text": "....別亂打，我只是來做廣告的....。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 0,
      "lines": [
        {
          "speaker": 156,
          "name": "大魔頭",
          "text": "最近的玩家越來越犀利了耶....。"
        },
        {
          "speaker": 158,
          "name": "程式魔頭",
          "text": "每次出場都被扁，好像自找罪受！"
        },
        {
          "speaker": 159,
          "name": "企劃魔頭",
          "text": "下次要設３２種特殊能力！！！等著瞧吧！"
        }
      ]
    }
  ]
}
