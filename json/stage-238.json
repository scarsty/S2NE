      "lines": [
        {
          "speaker": 40,
          "name": "柯莉特",
          "text": "嘿嘿，你們總算跟上來了....。"
        },
        {
          "speaker": 15,
          "name": "艾文",
          "text": "聽你的口氣，好像是故意要我們追上來似的。"
        },
        {
          "speaker": 40,
          "name": "柯莉特",
          "text": "一點也不錯。你們不覺得這個地方很特殊奇怪嗎？"
        },
        {
          "speaker": 14,
          "name": "飛霜",
          "text": "那又怎樣，妳想一個人和我們拚命嗎？"
        },
        {
          "speaker": 40,
          "name": "柯莉特",
          "text": "拚命？別擔心，我是死定了，但是你們也得陪葬！哈哈哈....。"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "什麼意思？"
        },
        {
          "speaker": 40,
          "name": "柯莉特",
          "text": "不懂嗎？就讓你們見識一下吧....。"
        }
      ]
    },
