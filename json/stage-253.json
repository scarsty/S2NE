      "lines": [
        {
          "speaker": 94,
          "name": "運金團副使",
          "text": "可惡！追得這麼急！根本甩不開。"
        },
        {
          "speaker": 60,
          "name": "鐵血戰士",
          "text": "副使....我們回頭和她們拚了吧！"
        },
        {
          "speaker": 94,
          "name": "運金團副使",
          "text": "拚？我們那有這本事？等等....你說得很對，你去和她們拚了吧！"
        },
        {
          "speaker": 60,
          "name": "鐵血戰士",
          "text": "我？"
        },
        {
          "speaker": 94,
          "name": "運金團副使",
          "text": "別擔心，我會多派幾個替死鬼和你一路去的。"
        }
      ]
    }
  ]
