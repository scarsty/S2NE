  "objects": [],
  "name": "提那城",
  "briefing": "",
  "objectives": {
    "victory": "消滅所有敵軍。",
    "defeat": "白志超或娜塔莉雅陣亡。"
  },
  "events": [
    {
      "type": 1,
      "completion_flag": 1,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 11,
          "name": "志超",
          "text": "鱷長老嗎？我們是受娜塔莉雅所託來幫您脫困的。"
        },
        {
          "speaker": 10,
          "name": "鱷長老",
          "text": "娜塔莉雅？那小妮子自己幹嘛不來，去去去，我不需要你們的幫助。"
        },
        {
          "speaker": 18,
          "name": "茱迪",
          "text": "娜塔莉雅說明天早上可能要發動另一次突擊呦，太晚回去指揮權可能就被蟬長老拿走了～回不回去？"
        },
        {
          "speaker": 10,
          "name": "鱷長老",
          "text": "好好好，娜塔莉雅這小妮子吃定我了，我回去就是。"
        },
        {
          "speaker": 18,
          "name": "茱迪",
          "text": "一次搞定。"
        }
      ]
    },
    {
      "type": 1,
      "completion_flag": 13,
      "trigger": {
        "kind": "turn",
        "turn": 4
      },
      "lines": [
        {
          "speaker": 69,
          "name": "城防司令官",
          "text": "弓弩手！城防隊！全力追擊，不要讓入侵者退走了！"
        },
        {
          "speaker": 18,
          "name": "茱迪",
          "text": "長老，該走了，不要打了！"
        },
        {
          "speaker": 10,
          "name": "鱷長老",
          "text": "好好好，我走就是。"
        }
      ]
    },
