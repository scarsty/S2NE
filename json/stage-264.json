    {
      "type": 9,
      "completion_flag": 11
    },
    {
      "type": 10,
      "completion_flag": 0,
      "raw_operands": {
        "offset_3": 13,
        "offset_5": 291,
        "offset_7": 14,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed",
      "lines": [
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "嗯，這就是南方領的軍事計劃書，裡面記載了南方領進攻時的兵力分佈與路線，要緊之極。"
        }
      ]
    },
    {
      "type": 9,
      "completion_flag": 4,
      "lines": [
        {
          "speaker": 15,
          "name": "艾文",
          "text": "這個事務官說得很漂亮，跑得也很快。"
        },
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "一路上這種事我們見多了。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "那我們現在該走了嗎？"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "等一下....小兵，你們怎麼知道我們要來這裡的。"
        },
        {
          "speaker": 81,
          "name": "黑魔導士",
          "text": "妳們和....他們的同伴也想混進府裡，被蘭瑟姆大人捉拿住了，他懷疑還有人想混進來，就下令我們警戒，接著就碰上妳們了....。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "糟了！泰普他們失手了！"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "那人關在那裡？"
        },
        {
          "speaker": 81,
          "name": "黑魔導士",
          "text": "就關在地下室的牢房裡....。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "我們快走！"
        }
      ]
    }
  ]
}
