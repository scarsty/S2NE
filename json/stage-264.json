  "events": [
    {
      "type": 3,
      "completion_flag": 13,
      "condition": 2,
      "role_id": 20,
      "lines": [
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "我....我受傷了！給我記住，我會回來報仇的！"
        }
      ]
    },
    {
      "type": 11,
