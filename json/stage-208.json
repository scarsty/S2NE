      "lines": [
        {
          "speaker": 27,
          "name": "寶兒",
          "text": "姊姊....怪物追上來了！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "真麻煩，早晚要解決的。"
        },
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "難怪這裡沒有衛兵防守。"
        }
      ]
    },
