      },
      "raw_operands_semantics": "unconfirmed",
      "lines": [
        {
          "speaker": 5,
          "name": "古斯塔夫",
          "text": "是南方領的衛兵嗎？"
        },
        {
          "speaker": 14,
          "name": "飛霜",
          "text": "什麼話，真失禮！我才要問妳們是不是南方領的衛兵呢？"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "那我們兩邊都不是南方領的人了，看來我們的處境很類似嘛。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "這位小姐....請先解決怪物再說，如何？"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "好極了，先對付怪物吧。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "痛快！大家一起動手吧！"
        }
      ]
    },
    {
      "type": 12,
