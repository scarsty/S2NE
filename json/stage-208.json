    },
    {
      "type": 2,
      "completion_flag": 0,
      "lines": [
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "原來各位的身手竟然如此精妙，小妹大感佩服。請問諸位是來自何處？又為何得罪夏普那奸人？"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "我們是來自北邊的....旅遊商人。才剛進宮就被伏擊，我們自己也莫名其妙，不知道那裡得罪了夏普。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "旅遊商人？好吧，我知道了。不知先生尊姓？"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "我叫白志超，這些朋友都是生意上的夥伴們。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "很好..那現在敵人已除，白先生可以自便了。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "好吧，有機會再見。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "再見。"
        }
      ]
    }
  ]
