  "objects": [],
  "name": "義助刑天",
  "briefing": "",
  "objectives": {
    "victory": "消滅所有敵軍。",
    "defeat": "白志超或娜塔莉雅陣亡。"
  },
  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "前面的朋友們，需要幫忙嗎？"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "呃....各位是？"
        },
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "我們是奚族部落的人，諸位可是白志超先生的朋友？"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "正是。你們是志超的朋友嗎？"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "可以這麼說，剛才還合作過一下。"
        },
        {
          "speaker": 17,
          "name": "秋月",
          "text": "既然是這樣，就多謝妳們的幫忙了。"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "不客氣，我早就想會一會南方領的首席劍客了。"
        },
        {
          "speaker": 5,
          "name": "古斯塔夫",
          "text": "那這些小兵就交給我吧。"
        }
      ]
    },
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 4
      },
      "lines": [
        {
          "speaker": 21,
          "name": "蘭瑟姆",
          "text": "好身手，就讓我來試試妳們的程度吧！"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 21,
      "lines": [
        {
          "speaker": 21,
          "name": "蘭瑟姆",
          "text": "....果然厲害，不過今天妳們人多了些，下次再見分曉吧！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "隨時奉陪。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 13,
      "lines": [
        {
          "speaker": 16,
          "name": "刑天",
          "text": "感謝各位的幫忙，單憑我們三人之力是打不過那蘭瑟姆的。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "奚族部落一向願意幫助朋友的，出手是應該的。"
        }
      ]
    },
