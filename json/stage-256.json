  "events": [
    {
      "type": 1,
      "completion_flag": 13,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 34,
          "name": "庫庫克",
          "text": "哎呀，這麼多的教士，不會是來捉我的吧？"
        },
        {
          "speaker": 11,
          "name": "白志超",
          "text": "....這應該是夏普派來阻止我們的部隊，只是想不到聖堂騎士也被夏普收買了。"
        },
        {
          "speaker": 74,
          "name": "聖堂騎士",
          "text": "收買？你這個野蠻人居然敢侮辱聖堂騎士，我代上天處罰你！"
        },
        {
          "speaker": 14,
          "name": "飛霜",
          "text": "收買又怎麼樣，瞧你一副不敢承認的樣子，要比價碼我還比你強得多呢！"
        }
      ]
    },
    {
      "type": 11,
      "completion_flag": 0,
      "condition": 2,
      "raw_operands": {
        "offset_3": 13,
        "offset_5": 34,
        "offset_7": 0,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed",
      "lines": [
        {
          "speaker": 34,
          "name": "庫庫克",
          "text": "哇！大姐。真帶勁啊。"
        },
        {
          "speaker": 14,
          "name": "飛霜",
          "text": "嘻，那裡，那裡。"
        },
        {
          "speaker": 74,
          "name": "聖堂騎士",
          "text": "渾蛋！收拾這些骯髒的異教徒！"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 0,
      "lines": [
        {
          "speaker": 14,
          "name": "飛霜",
          "text": "哼....技術這樣差，想當殺手都沒有別人願意請你呢！還敢在那邊扭捏作態，噁心！"
        },
        {
          "speaker": 34,
          "name": "庫庫克",
          "text": "大姐！我越來越崇拜你了！"
        }
      ]
    },
