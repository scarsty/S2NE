  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 35,
          "name": "歐西德",
          "text": "糟了，這是官道巡邏隊的主力，來得如此迅速！"
        },
        {
          "speaker": 27,
          "name": "寶兒",
          "text": "我好怕....。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "要打嗎？"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "騎兵太多了，打起來很容易傷亡慘重。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "好，先退後再說！"
        }
      ]
    },
    {
      "type": 1,
      "completion_flag": 1,
      "trigger": {
        "kind": "turn",
        "turn": 4
      },
      "lines": [
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "前面這夥人就是常和我們作對的那批人嗎？"
        },
        {
          "speaker": 37,
          "name": "西碧拉",
          "text": "是的，就是他們。"
        },
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "嗯....奚族的娜塔莉雅！久聞其名，真是意外啊。"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "呸，居然不認得我！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "不妙，連南方領的軍事統帥貝洛都來了，這裡不能久待了！"
        },
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "等我捉到你們，奚族就只好和我乖乖談和了，嘿嘿嘿。"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 13,
      "condition": 2,
      "role_id": 39,
      "lines": [
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "奚族的人竟然本事不小？下次要更加小心....。"
        }
      ]
    },
