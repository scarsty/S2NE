      "raw_operands_semantics": "unconfirmed",
      "lines": [
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "來吧！看看誰能取我的性命，我會讓你們付出代價的！"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "好氣魄！可惜死不悔改，只有除惡務盡了！"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 39,
      "lines": [
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "死....死在你們手裡，總勝過死在那些貪生怕死的螞蟻手下....哈哈哈..。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "別死～告訴我，你為何要進攻奚族？"
        },
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "去..去問....克雷布特里吧....可恨啊....。"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "克雷布特里？這個小人？"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "他在那裡？為何他沒有和你在一起？"
        },
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "聖....聖..地，奚....族....。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 0,
      "lines": [
        {
          "speaker": 11,
          "name": "志超",
          "text": "是奚族的聖地，我們快走。"
        }
      ]
    }
