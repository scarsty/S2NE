    },
    {
      "type": 11,
      "completion_flag": 0,
      "condition": 7,
      "raw_operands": {
        "offset_3": 14,
        "offset_5": 18,
        "offset_7": 999,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed",
      "lines": [
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "泰普、黛西，你們沒事吧。"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "沒事啦，只是臉丟大了。"
        },
        {
          "speaker": 6,
          "name": "黛西",
          "text": "妳們來得真快，我們才剛被送進來呢。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "哈，你們兩個和茱迪被送進這間黑牢，這下豈不是有失顏面？"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "別提了，這次臉可丟大了。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "那南巡使呢？"
        },
        {
          "speaker": 17,
          "name": "秋月",
          "text": "被南方領的人帶走了，看樣子身份是暴露了。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "現在沒時間管他了，我們先離開這個地方吧。"
        }
      ]
    },
