  "events": [
    {
      "type": 1,
      "completion_flag": 13,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 26,
          "name": "典獄長",
          "text": "小心！有侵入者！"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "是這裡嗎？"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "動作要快！速戰速決！"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 14,
      "condition": 2,
      "role_id": 26,
      "lines": [
        {
          "speaker": 11,
          "name": "志超",
          "text": "太好了，鑰匙到手了。"
        }
      ]
    },
    {
      "type": 11,
      "completion_flag": 0,
      "condition": 7,
      "raw_operands": {
        "offset_3": 14,
