  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 40,
          "name": "柯莉特",
          "text": "敢殺進來？沝備接我的飛斧吧！"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 40,
      "lines": [
        {
          "speaker": 40,
          "name": "柯莉特",
          "text": "....今天我的主力不在這裡，下次再和你們一決死戰吧！"
        },
        {
          "speaker": 15,
          "name": "艾文",
          "text": "下次妳就沒有這麼好運了。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 13,
      "lines": [
        {
          "speaker": 11,
          "name": "志超",
          "text": "事不宜遲，我們快追上去。"
        },
        {
          "speaker": 150,
          "name": "小村村民",
          "text": "等一下！"
        },
        {
          "speaker": 18,
          "name": "茱迪",
          "text": "怎麼了？"
        },
        {
          "speaker": 150,
          "name": "小村村民",
          "text": "她....她們在這附近還留有一群部隊，請幫助我們先打敗這些人吧。"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "這附近還有敵兵？志超？"
        }
      ]
    },
