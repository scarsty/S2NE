  "objects": [],
  "name": "沙盜黑蠍子",
  "briefing": "",
  "objectives": {
    "victory": "消滅所有敵軍。",
    "defeat": "白志超或娜塔莉雅陣亡。"
  },
  "events": [
    {
      "type": 1,
      "completion_flag": 44,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 50,
          "name": "護衛隊長",
          "text": "我認得他！那就是沙盜的頭目黑蠍子！"
        },
        {
          "speaker": 13,
          "name": "羅莎莉",
          "text": "那....既然沙盜先來了，商隊呢？"
        },
        {
          "speaker": 15,
          "name": "艾文",
          "text": "對啊？人都跑到那去了？"
        },
        {
          "speaker": 14,
          "name": "飛霜",
          "text": "我覺得沙盜群只找到車隊出氣，人....恐怕他們也沒找到。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "喂！呆頭呆腦的沙盜，你們的營地已經被我們挑了，沒有根據地可以依靠了，還不快快投降？"
        },
        {
          "speaker": 41,
          "name": "黑蠍子",
          "text": "他在放什麼屁？"
        },
        {
          "speaker": 130,
          "name": "沙盜戰士",
          "text": "老大，他說得可能是真的，營地已經很久沒有升起狼煙來聯絡了。"
        },
        {
          "speaker": 41,
          "name": "黑蠍子",
          "text": "混蛋！殺光他們！只要留下一個活口問話就可以了！"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "呆頭鵝不肯投降嗎？那就來打一場吧。"
        }
      ]
    },
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 4
      },
      "lines": [
        {
          "speaker": 41,
          "music_after": 6,
          "name": "黑蠍子",
          "text": "衝啊！孩子們和我一起上!"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 41,
      "lines": [
        {
          "speaker": 41,
          "name": "黑蠍子",
          "text": "不算，不算....。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 13,
      "lines": [
        {
          "speaker": 11,
          "name": "志超",
          "text": "沙盜只會耍嘴皮子嗎？還不是被我們殲滅了。"
        },
        {
          "speaker": 50,
          "name": "護衛隊長",
          "text": "從此行旅更加安全了。"
        }
      ]
    },
