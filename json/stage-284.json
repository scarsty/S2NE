        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "還來的及嗎？"
        },
        {
          "speaker": 15,
          "name": "艾文",
          "text": "兩邊還在激戰中，看樣子還有機會。"
        },
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "志超！總管快撐不住了，我們快去幫她吧！"
