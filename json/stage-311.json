  "objects": [],
  "name": "勇士與鬥士",
  "briefing": "",
  "objectives": {
    "victory": "消滅所有敵軍。",
    "defeat": "白志超或娜塔莉雅陣亡。"
  },
  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 36,
          "name": "羅許",
          "text": "這....連這座橋也被攻下來了....不過總算趕上了。"
        },
        {
          "speaker": 121,
          "name": "暹族活屍仙",
          "text": "娜塔莉雅？妳居然能趕到這裡來？那個作夢想選族長的人果然是個廢物！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "暹族的長老，請聽我一言，只為了南方領支援武器就破壞兩族間的交好實在不值得，請下令退兵吧。"
        },
        {
          "speaker": 121,
          "name": "暹族活屍仙",
          "text": "哈....妳是在癡人說夢話！我們暹族老是被你們給壓在第二，如今有此大好良機出此烏氣，那有可能就此罷手，妳過來領死吧！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "長老不聽我勸，那只有得罪了！"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 121,
      "lines": [
        {
          "speaker": 121,
          "name": "暹族活屍仙",
          "text": "....我....我....怎會死在凡人手裡....。"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "你早該投胎啦！老巫妖。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 0,
      "lines": [
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "我們要找出提供裝備的地方，不然這件事不容易善了的。"
        },
        {
          "speaker": 36,
          "name": "羅許",
          "text": "有誰知道暹族的裝配是從那裡來的？"
        },
        {
          "speaker": 60,
          "name": "奚族戰士",
          "text": "剛才聽他們說，是先運到鄰村再分配給各部隊的。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "鄰村？那為何這件事族人一無所知？"
        },
        {
          "speaker": 60,
          "name": "奚族戰士",
