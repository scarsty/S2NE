  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 15,
          "name": "艾文",
          "text": "看來應該繞路的....。"
        },
        {
          "speaker": 14,
          "name": "飛霜",
          "text": "這可不妙了，想不到居然是真的....。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "也罷，一路上都和活人交戰，還沒有碰過死人，換換口味也好。"
        },
        {
          "speaker": 12,
          "name": "南巡使",
          "text": "我真是服了你，你現在還能說笑？"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "就算再來一百隻妖怪，我也不會在乎的。"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "好氣魄，我們一塊上吧。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 13,
      "lines": [
        {
          "speaker": 15,
          "name": "艾文",
          "text": "這下我們變成打鬼英雄了。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "我可不以此為榮啊。"
        }
      ]
    },
