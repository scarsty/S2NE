  "events": [
    {
      "type": 1,
      "completion_flag": 13,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 18,
          "name": "茱迪",
          "text": "奧帕兒在前面。"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "噢，不妙。是貝洛的人手。"
        },
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "太好了，夏普老狐狸除掉了，連他女兒也一併拿到，今日大功告成。"
        },
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "恭喜元帥，祝元帥德高權重，消滅奚族，一統南疆！"
        },
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "克雷布特里！你這個叛徒！我爹爹呢？"
        },
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "識時務者為俊傑，昏庸的夏普前領主已經死了，我現在效忠的是雄才大略的新領主貝洛元帥，妳不可無禮。"
        },
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "後面那些是什麼人?"
        },
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "回領主，是迦納國派來南方的探子。"
        },
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "那麼，和奧帕兒一起拿下吧。"
        }
      ]
    },
    {
      "type": 12,
      "completion_flag": 49,
      "condition": 22,
      "raw_operands": {
        "offset_3": 13,
        "offset_5": 22,
        "offset_7": 0,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed"
    },
    {
      "type": 12,
      "completion_flag": 0,
      "condition": 22,
      "raw_operands": {
        "offset_3": 13,
        "offset_5": 32,
        "offset_7": 0,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed"
    },
    {
      "type": 3,
      "completion_flag": 5,
      "condition": 2,
      "role_id": 22,
      "lines": [
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "志超....。"
        },
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "剩下的小狗，通通殺了吧。"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 4,
      "condition": 2,
      "role_id": 29,
      "lines": [
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "我是不會死的！"
        }
      ]
    },
    {
      "type": 1,
      "completion_flag": 14,
      "trigger": {
        "kind": "turn",
        "turn": 5
      },
      "lines": [
        {
          "speaker": 22,
          "music_after": 12,
          "name": "奧帕兒",
          "text": "住手！"
        },
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "奧帕兒小姐，妳打算向尊貴的貝洛元帥請降了嗎？"
        },
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "貝洛....我知道你要的是什麼。"
        },
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "哼哼，很好，那又怎麼樣？"
        },
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "如果你讓我的同伴們離開，我就....我就....答應你。"
        },
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "笑話，現在管妳答不答應，根本由不得妳了。"
        },
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "是嗎....如果我死了....誰還能強迫我呢？"
        },
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "....你不敢的！"
        },
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "要試試看嗎！"
        },
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "哼..也罷，這幾隻小狗我還不放在眼裡，就讓他們滾吧！"
        },
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "志超....我....你.....。你一定要離開這裡，不然我留下來就沒意義了，好嗎？你騙了我好久，原來你是迦納國的探子，你真是壞啊....。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "奧帕兒....我....。"
        },
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "不用說了，快走吧..。"
        }
      ]
    },
