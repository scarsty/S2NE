    },
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 4
      },
      "lines": [
        {
          "speaker": 83,
          "name": "邪魔法師",
          "text": "唉，米蘭黛，妳還沒死啊，這樣我主人會不高興的。"
        },
        {
          "speaker": 31,
          "name": "米蘭黛",
          "text": "只要我還有一口氣在，夏普的惡行就休想遮掩掉！"
        },
        {
          "speaker": 83,
          "name": "邪魔法師",
          "text": "不聰明的孩子，只有送妳去了。"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 83,
      "lines": [
        {
          "speaker": 83,
          "name": "邪魔法師",
          "text": "哇...南方領萬歲！"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 0,
      "lines": [
        {
          "speaker": 31,
          "name": "米蘭黛",
          "text": "多謝各位朋友，若不是你們的幫助，米家一脈或許就在此一戰中覆滅了，請接受我的致謝。"
        },
        {
          "speaker": 6,
          "name": "黛西",
          "text": "助人本是份內之事，不用致謝的。"
        },
        {
          "speaker": 5,
          "name": "古斯塔夫",
          "text": "是啊，是啊，我們本來就和夏普有仇，只是順便幫忙而已。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "現在妳家道中落，妳打算接下來要如何處理此後諸事？"
        },
        {
          "speaker": 31,
          "name": "米蘭黛",
          "text": "我想過了，我既然父母已亡，家族聲望不可能回復，且各位既然與夏普敵對，請讓我加入盡一分力吧。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "那麼....妳是我們的新夥伴了。"
        }
      ]
    }
  ]
}
