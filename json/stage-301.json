  "objects": [],
  "name": "落難的騎士",
  "briefing": "",
  "objectives": {
    "victory": "消滅所有敵軍。",
    "defeat": "白志超或娜塔莉雅陣亡。"
  },
  "events": [
    {
      "type": 1,
      "completion_flag": 57,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 111,
          "name": "領主府殺手",
          "text": "米蘭黛，這下你再也逃不了了，乖乖受死吧！"
        },
        {
          "speaker": 31,
          "name": "米蘭黛",
          "text": "夫人和老爺呢？"
        },
        {
          "speaker": 149,
          "name": "米家僕役",
          "text": "老..爺和夫人都被夏普派來的人殺死了，小姐要替他們報仇啊！"
        },
        {
          "speaker": 31,
          "name": "米蘭黛",
          "text": "@@WA7,00D26@@什麼！@@RWRD@@"
        },
        {
          "speaker": 111,
          "name": "領主府殺手",
          "text": "米蘭黛，別傷心了，我這就送妳去見妳的爹娘吧，上！"
        },
        {
          "speaker": 31,
          "name": "米蘭黛",
          "text": "來吧！"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "聽到了嗎？"
        },
        {
          "speaker": 6,
          "name": "黛西",
          "text": "這種事豈有不管之理？"
        },
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "路見不平，拔刀相助是我們奚族的行規。"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "那我們還等什麼，上吧。"
        }
      ]
    },
    {
      "type": 11,
