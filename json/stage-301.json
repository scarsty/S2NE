      "lines": [
        {
          "speaker": 11,
          "name": "志超",
          "text": "奧帕兒....我對不起妳....。"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "......。"
        },
        {
          "speaker": 32,
          "name": "法科爾",
          "text": "小姐....。"
        },
        {
          "speaker": 31,
          "name": "米蘭黛",
          "text": "..我家和夏普的血海深仇，就此作罷。"
        },
