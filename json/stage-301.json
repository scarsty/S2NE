      "lines": [
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "很好，妳很聽話，跟我回宮去吧。"
        },
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "祝元帥大人喜獲佳人。"
        },
        {
          "speaker": 39,
          "name": "貝洛元帥",
          "text": "哼哼，收兵。"
        }
      ]
    },
    {
