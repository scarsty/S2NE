  "objects": [],
  "name": "突圍的選擇",
  "briefing": "",
  "objectives": {
    "victory": "消滅所有敵軍。",
    "defeat": "白志超或娜塔莉雅陣亡。"
  },
  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 6,
          "name": "黛西",
          "text": "後面有騎兵隊....退路被截斷了！"
        },
        {
          "speaker": 5,
          "name": "古斯塔夫",
          "text": "前面也有大隊人馬，情況好像....不太對勁啊！"
        },
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "往林中退後，不要和騎兵隊正面衝突，怎麼樣？"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "不....現在不能打防禦戰，要各個擊破，往騎兵隊的方向突圍！"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "這次要玩真的啦。"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 74,
      "lines": [
        {
          "speaker": 74,
          "name": "騎兵隊長",
          "text": "怎..怎麼會輸給步兵....。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 13,
      "lines": [
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "快走，再有人來就沒力氣應付了。"
        },
        {
          "speaker": 5,
          "name": "古斯塔夫",
          "text": "那要往那裡去呢？"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "回奚族的路上南方領一定會派出重兵把守，我們不能往回走。往亞修斯的路上多半也有援軍往來，只能往南北方向走。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "大長老之前提過礦場之事，可以往南去採石場調查。"
        },
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "北邊的罕泉鎮經常有商旅往來，我們在路上不容易被發現。"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "去那裡都好，快決定吧。"
        }
      ]
    },
    {
      "type": 9,
      "completion_flag": 0,
      "condition": 6,
      "route_stage": 80
    },
    {
