  "objects": [],
  "name": "超時空傳說",
  "briefing": "",
  "objectives": {
    "victory": "消滅所有敵軍。",
    "defeat": "白志超或娜塔莉雅陣亡。"
  },
  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "你們壞了我大事！我要消滅你們！！！"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "我們已經知道你的來歷了....是很可憐，但被你利用的人不是也有和你一樣的心態嗎？"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "何況，你只是有家歸不得，許多人卻是再也回不了家了....。"
        },
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "這些都是廢話，只要妳們不再阻撓我，我就可以回去找傳送局算帳了，再也不會和妳們有任何一點關聯！聽懂了嗎？@@WA7,00D3D@@不要阻撓我！！！@@RWRD@@"
        },
        {
          "speaker": 13,
          "name": "羅莎莉",
          "text": "如果你沒有引發這次的兩族對立，我們那裡會阻止你？"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "就是因為你絲毫不顧別人的感受，現在要受到別人的影響了。"
        },
        {
          "speaker": 31,
          "name": "米蘭黛",
          "text": "你的私心太過，和恣意而行的暴君有何不同？"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "你必須為之前的過錯付出代價，這是必然的。"
        },
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "好！妳們肯定是要和我作對了，就讓你們瞧瞧我不死身的厲害吧！"
        }
      ]
    },
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 3
      },
      "lines": [
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "我忠心的僕人啊，去消滅我的敵人吧。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 13,
      "lines": [
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "啊.....我的護身符！這是不可能的！！！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "結束了....。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "我們回去吧。"
        }
      ]
    },
    {
