      "role_id": 40,
      "lines": [
        {
          "speaker": 40,
          "name": "柯莉特",
          "text": "....我好恨啊....。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 0,
      "lines": [
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "柯莉特好歹也算是一代名將，讓我們為她致意吧。"
        },
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "好個英雄，穆爾敬佩妳！"
        }
      ]
    }
