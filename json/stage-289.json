  "events": [
    {
      "type": 1,
      "completion_flag": 16,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 3,
          "name": "泰普",
          "text": "好了啦，不要再找入口了，我覺得從廚房混進去的計劃已經很好了。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "這件事急不得，多擬幾個計劃保險的多，至少今天還要多看看....。"
        }
      ]
    },
    {
      "type": 13,
      "completion_flag": 0,
      "condition": 1,
      "raw_operands": {
        "offset_3": 16,
        "offset_5": 188,
        "offset_7": 0,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed",
      "lines": [
        {
          "speaker": 27,
          "music_after": 24,
          "name": "小女孩",
          "text": "救命啊....。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "有小女孩的哭聲..？"
        },
        {
          "speaker": 5,
          "name": "古斯塔夫",
          "text": "是在喊救命，快過去看看！"
        }
      ]
    },
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 2
      },
      "lines": [
        {
          "speaker": 65,
          "name": "拳師",
          "text": "小女孩，你不要怪我，誰叫妳聽到不該聽到的話....。"
        },
        {
          "speaker": 27,
          "name": "小女孩",
          "text": "救命啊，大哥哥大姊姊....。"
        },
        {
          "speaker": 65,
          "name": "拳師",
          "text": "尋常村民那裡救得了妳，要和妳說再見了！"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 13
    },
    {
      "type": 14,
      "completion_flag": 0,
      "condition": 1,
      "raw_operands": {
        "offset_3": 13,
        "offset_5": 27,
        "offset_7": 20,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed"
    },
    {
      "type": 14,
      "completion_flag": 0,
      "raw_operands": {
        "offset_3": 13,
        "offset_5": 27,
        "offset_7": 6,
        "offset_9": 10
      },
      "raw_operands_semantics": "unconfirmed"
    },
    {
      "type": 14,
      "completion_flag": 0,
      "raw_operands": {
        "offset_3": 13,
        "offset_5": 27,
        "offset_7": 1,
        "offset_9": 10
      },
      "raw_operands_semantics": "unconfirmed",
      "lines": [
        {
          "speaker": 27,
          "name": "小女孩",
          "text": "哇....我好怕，我真的沒事嗎？"
        },
        {
          "speaker": 6,
          "name": "黛西",
          "text": "小妹妹不要怕，那些兵丁為什麼要抓妳？"
        },
        {
          "speaker": 27,
          "name": "小女孩",
          "text": "爺爺....爺爺他被壞人抓走了，爺爺保護寶兒逃走，壞人就把爺爺抓起來了。"
        },
        {
          "speaker": 6,
          "name": "黛西",
          "text": "原來妳叫做寶兒啊，那寶兒的爺爺叫什麼名字？"
        },
        {
          "speaker": 27,
          "name": "寶兒",
          "text": "寶兒的爺爺叫做歐西德。"
        },
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "歐西德？好像有聽過？不太熟悉？"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "沒聽過，誰知道這個小女孩是何方神聖？"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "....寶兒妳的爺爺被關在那裡？"
        },
        {
          "speaker": 27,
          "name": "寶兒",
          "text": "就是後面那棟大房子裡，爺爺就在那裡面....。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "她說的是夏普的官邸！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "....嗯，也許這位歐西德知道一些重要的事情..。"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "娜塔，妳不會是想帶這個小女孩到領主府裡去吧。"
        }
      ]
    },
