  "events": [
    {
      "type": 1,
      "completion_flag": 13,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 5,
          "name": "古斯塔夫",
          "text": "咦....？"
        },
        {
          "speaker": 40,
          "name": "柯莉特",
          "text": "奚族的小狗們，還認得我吧！"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "....原來是柯莉特將軍啊....失敬失敬....不知有何貴幹？"
        },
        {
          "speaker": 6,
          "name": "黛西",
          "text": "別逗她了，任務失敗這時候心情一定很壞。"
        },
        {
          "speaker": 40,
          "name": "柯莉特",
          "text": "....對....我現在心情壞透了，你們準備領死吧！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "有伏兵嗎？"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "感覺不到，現在看到的應該是全部的兵力了！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "柯莉特！我接受你的挑戰！"
        }
      ]
    },
