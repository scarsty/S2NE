  "objects": [],
  "name": "採石場",
  "briefing": "",
  "objectives": {
    "victory": "消滅所有敵軍。",
    "defeat": "白志超或娜塔莉雅陣亡。"
  },
  "events": [
    {
      "type": 1,
      "completion_flag": 13,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 73,
          "name": "顧將軍",
          "text": "唉....為什麼我會被派到這種鬼地方來，我到底得罪誰了。"
        },
        {
          "speaker": 56,
          "name": "拳術侍衛",
          "text": "將軍吉星高照，早晚會調回亞修斯城的。"
        },
        {
          "speaker": 73,
          "name": "顧將軍",
          "text": "別說了，來到這裡十幾天了，連我都不許進礦坑，這算什麼嘛！"
        },
        {
          "speaker": 56,
          "name": "拳術侍衛",
          "text": "將軍負責抵禦外敵，礦坑內的雜事就交給下人去辦吧。"
        },
        {
          "speaker": 73,
          "name": "顧將軍",
          "text": "敵人？誰會來攻擊這種三流小礦場？真搞不懂上頭的想法....。"
        },
        {
          "speaker": 52,
          "name": "礦坑衛兵",
          "text": "將軍，有可疑人物接近！"
        }
      ]
    },
    {
      "type": 12,
      "completion_flag": 0,
      "condition": 16,
      "raw_operands": {
        "offset_3": 13,
        "offset_5": 56,
        "offset_7": 0,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed",
      "lines": [
        {
          "speaker": 73,
          "name": "顧將軍",
          "text": "真的！？那我有事可以做啦！"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 73,
      "lines": [
        {
          "speaker": 73,
          "name": "顧將軍",
          "text": "哇....我還要回亞修斯享福呢！"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 14,
      "lines": [
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "這種地方居然會配置重兵防守．一定有問題。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "地面下傳來著奇怪的氣息....和聖殿內的感覺很相近....。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "我們下去偵查，大家小心為是。"
        }
      ]
    },
