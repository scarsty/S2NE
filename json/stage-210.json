  "events": [
    {
      "type": 1,
      "completion_flag": 13,
      "trigger": {
        "kind": "turn",
        "turn": 2
      },
      "lines": [
        {
          "speaker": 70,
          "name": "駐軍隊長",
          "text": "站住！所有過往商旅都要停下受檢。"
        },
        {
          "speaker": 12,
          "name": "南巡使",
          "text": "怎麼辦，要停下來受檢嗎？"
        },
        {
          "speaker": 70,
          "name": "駐軍隊長",
          "text": "猶豫什麼！趕快過來受檢！"
        }
      ]
    },
