    {
      "type": 6,
      "completion_flag": 4,
      "raw_operands": {
        "offset_3": 16,
        "offset_5": 50,
        "offset_7": 0,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed",
      "lines": [
        {
          "speaker": 50,
          "music_after": 27,
          "name": "商隊隊長",
          "text": "啊..請等一下，麥隊長。"
        },
        {
          "speaker": 70,
          "name": "駐軍隊長",
          "text": "旅行商隊的護衛隊長？這些人和你有關係嗎？"
        },
        {
          "speaker": 50,
          "name": "商隊隊長",
          "text": "是的，這次我們商隊之所以能安全逃過沙盜的追擊，全靠這幾位朋友幫忙，我可以保證他們不是歹人，希望麥隊長能順利予以放行。"
        },
        {
          "speaker": 70,
          "name": "駐軍隊長",
          "text": "....既然你肯擔保，就讓他們通過也無妨，我看這幾個傢伙也不像是盜賊，好吧，你們繳交通關費之後就可以過去了。"
        },
        {
          "speaker": 50,
          "name": "商隊隊長",
          "text": "多謝麥隊長賞臉。"
        },
        {
          "speaker": 70,
          "name": "駐軍隊長",
          "text": "好了，下次多陪我喝兩杯便是了。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "那我們過關吧。"
        }
      ]
    },
    {
      "type": 9,
      "completion_flag": 0
    },
    {
      "type": 1,
      "completion_flag": 17,
      "trigger": {
        "kind": "turn",
        "turn": 3
      }
    },
    {
      "type": 9,
      "completion_flag": 1,
      "condition": 1,
      "required_flags": [
        14,
        17
      ],
      "lines": [
        {
          "speaker": 12,
          "name": "南巡使",
          "text": "旁邊有路可以跑啊，快溜吧！"
        },
        {
          "speaker": 14,
          "name": "飛霜",
          "text": "予以否決！"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "沒辦法，又要打一場了。"
        },
        {
          "speaker": 70,
          "name": "駐軍隊長",
          "text": "好個善良百姓，眾衛兵全上！"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 15,
      "condition": 2,
      "lines": [
        {
          "speaker": 11,
          "name": "志超",
          "text": "呼....好累，下次不玩了。"
        },
        {
          "speaker": 12,
          "name": "南巡使",
          "text": "沒辦法，總不能被搜身啊，不跑不行。"
        },
        {
          "speaker": 14,
          "name": "飛霜",
          "text": "把你送到亞修斯後，我一定要好好打一場。"
        }
      ]
    },
