  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 4,
          "name": "蘇",
          "text": "....這麼多的教士，不會是夏普派來阻止我們的吧？"
        },
        {
          "speaker": 35,
          "name": "歐西德",
          "text": "沒錯，這些人就是南方領握有的傭兵集團之一，專門打擊異己用的。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "想不到聖堂騎士也被夏普收買了。"
        },
        {
          "speaker": 74,
          "name": "聖堂騎士",
          "text": "收買？妳這個野蠻人居然敢侮辱聖堂騎士，我代上天處罰你！"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "惺惺作態的傢伙，我看你就有火！"
        }
      ]
    },
    {
      "type": 1,
      "completion_flag": 13,
      "trigger": {
        "kind": "turn",
        "turn": 2
      },
      "lines": [
        {
          "speaker": 74,
          "name": "聖堂騎士",
          "text": "混帳！努力消滅異教徒！"
        }
      ]
    },
