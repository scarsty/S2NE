  "objects": [],
  "name": "暹族的伏擊",
  "briefing": "",
  "objectives": {
    "victory": "消滅所有敵軍。",
    "defeat": "白志超或娜塔莉雅陣亡。"
  },
  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 105,
          "name": "暹族頭目",
          "text": "娜塔莉雅，妳好大的膽子，居然真的敢一路跟來。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "我來這裡是想知道暹族部落的態度。"
        },
        {
          "speaker": 105,
          "name": "暹族頭目",
          "text": "只有戰！沒有和！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "....今日之事一定不能善了嗎？"
        },
        {
          "speaker": 105,
          "name": "暹族頭目",
          "text": "絕對不行！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "好....那就用部落的方式來解決吧！"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 105,
      "lines": [
        {
          "speaker": 105,
          "name": "暹族頭目",
          "text": "輸....輸了..！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "回去告訴妳們長老，如果還不肯罷休，@@WA7,00D3D@@娜塔莉雅@@RWRD@@隨時候教！"
        },
        {
          "speaker": 105,
          "name": "暹族頭目",
          "text": "....知道了。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 13,
      "lines": [
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "經過今天這一役，暹族應該服氣了吧。"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "哇哈哈，正面對決大獲全勝的感覺真好！"
        },
        {
          "speaker": 5,
          "name": "古斯塔夫",
          "text": "教她們知道奚族戰士才是真正的戰士！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "通知這裡的夥伴，把這一仗的消息傳回去，等候大長老的命令。"
        },
        {
          "speaker": 6,
          "name": "黛西",
          "text": "好的。"
        }
      ]
    },
