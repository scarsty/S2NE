      "condition": 2,
      "role_id": 80,
      "lines": [
        {
          "speaker": 80,
          "name": "大魔導士",
          "text": "法..法爾科，貝洛大人並不是只派出我而已，你們的日子難過了。"
        },
        {
          "speaker": 32,
          "name": "法爾科",
          "text": "看來我們不能往回走了。"
        },
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "帶我離開亞修斯吧，這個地方不能待了。"
        },
        {
          "speaker": 32,
          "name": "法爾科",
          "text": "那妳打算到那裡去？"
        },
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "跟我來吧。"
        }
      ]
