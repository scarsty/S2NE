      },
      "raw_operands_semantics": "unconfirmed",
      "lines": [
        {
          "speaker": 80,
          "name": "大魔導士",
          "text": "任務失敗....當然該死。"
        },
        {
          "speaker": 32,
          "name": "法爾科",
          "text": "好啊，幕後主使者出現了。咦？你....你是貝洛元帥手下六護衛之一，難道....？"
        },
        {
          "speaker": 80,
          "name": "大魔導士",
          "text": "....既然你知道了，我是不能饒你了。"
        },
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "貝洛！殺手是貝洛派來的！"
        },
        {
          "speaker": 80,
          "name": "大魔導士",
          "text": "談話就到此為止，準備受死吧。"
        }
      ]
    },
    {
      "type": 14,
      "completion_flag": 0,
      "raw_operands": {
