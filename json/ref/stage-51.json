                       "lines":  [
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "志超！"
                                     },
                                     {
                                         "speaker":  19,
                                         "name":  "夏普",
                                         "text":  "啊....是你們。"
                                     }
                                 ]
                   },
                   {
                       "type":  9,
                       "completion_flag":  0,
                       "lines":  [
                                     {
                                         "speaker":  31,
                                         "name":  "米蘭黛",
                                         "text":  "夏普，這次你還有什麼話說？"
                                     },
                                     {
                                         "speaker":  19,
                                         "name":  "夏普",
                                         "text":  "....來吧，妳要報仇就過來吧。"
                                     },
                                     {
                                         "speaker":  31,
                                         "name":  "米蘭黛",
                                         "text":  "我不打算殺你，我只要把你帶回去公審就可以了。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "志超，再給我爹爹多一次機會吧。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "奧帕兒，你父親對不起米蘭黛一家人是事實，我不能幫忙。"
                                     },
                                     {
                                         "speaker":  31,
                                         "name":  "米蘭黛",
                                         "text":  "夏普，跟我回去認罪吧。"
                                     }
                                 ]
                   },
                   {
                       "type":  9,
                       "completion_flag":  4,
                       "condition":  4,
                       "any_flags":  [
                                         13
                                     ]
                   },
                   {
                       "type":  9,
                       "completion_flag":  14,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "....夏普，你不該逃跑的，自己做的事該自己負責。"
                                     },
                                     {
                                         "speaker":  19,
                                         "name":  "夏普",
                                         "text":  "你....非要逼我走上絕路嗎？"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  0,
                       "branch_flag":  14,
                       "lines":  [
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "志超，再給我爹爹多一次機會吧。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "放夏普一馬。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "將夏普帶回去。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  15,
                       "condition":  1,
                       "branch_flag":  14,
                       "branch_value":  1,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "罷了，就當作我沒看見吧，妳們快走吧。"
                                     },
                                     {
                                         "speaker":  19,
                                         "name":  "夏普",
                                         "text":  "你....你真的要放我走？"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "志超，謝謝你，我會感激你的。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "別提了，妳們快走吧。"
                                     },
                                     {
                                         "speaker":  19,
                                         "name":  "夏普",
                                         "text":  "等一下，我還有一件事要告訴你。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "咦？"
                                     },
                                     {
                                         "speaker":  19,
                                         "name":  "夏普",
                                         "text":  "小心克雷布特里，他才是握有力量的人。我接受了他提供的武器、技術，才會犯下這些錯誤....。不知道為什麼，他處心積慮地想要攻下奚族的聖地，為了這個目的他願意付出任何代價。小心！小心！克雷布特里身上裝配了@@WA7,00D5D@@打不死的物品@@RWRD@@，如果不先毀去這個東西，你們是殺不死他的。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "克雷布特里？你沒有推卸責任吧？"
                                     },
                                     {
                                         "speaker":  19,
                                         "name":  "夏普",
                                         "text":  "不要小看克雷布特里！他擁有最先進的知識，這次的戰爭對他來說根本不重要，他唯一的目的只是要進入@@WA7,00D4D@@奚族的聖地@@RWRD@@。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "我記得有一個魔術可以摧毀物品，也許你們該準備一下。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "....好吧，我會記得的。"
                                     }
                                 ]
