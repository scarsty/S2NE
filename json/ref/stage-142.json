                                        },
                       "raw_operands_semantics":  "unconfirmed",
                       "lines":  [
                                     {
                                         "speaker":  12,
                                         "name":  "南巡使",
                                         "text":  "她們是奚族的人....。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "怎麼辦，我總不能介紹你是我國的間諜吧，真是....。"
                                     },
                                     {
                                         "speaker":  13,
                                         "name":  "羅莎莉",
                                         "text":  "這些奚族勇士的領導人居然是女孩，真不簡單。"
                                     },
                                     {
                                         "speaker":  17,
                                         "name":  "秋月",
                                         "text":  "嗯，看來後面的幾個大個子都很服她呢。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "那我們出發往亞修斯走吧。說不定還有機會遇到她們的。"
                                     },
                                     {
                                         "speaker":  12,
                                         "name":  "南巡使",
                                         "text":  "這裡離亞修斯已經不遠了，不再適合大隊結伴而行，我看我也該走了。"
                                     },
                                     {
                                         "speaker":  16,
                                         "name":  "刑天",
                                         "text":  "不如我們分做兩隊前往亞修斯城，以免太過引人注目。"
                                     },
                                     {
                                         "speaker":  17,
                                         "name":  "秋月",
                                         "text":  "然後等到南巡使收集到足夠的情報後我們再會合，決定接下去的任務。"
                                     },
                                     {
                                         "speaker":  18,
                                         "name":  "茱迪",
                                         "text":  "秋月，那我和妳們一路吧。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "妳們自己留意，到了亞修斯城我們再聯繫。"
                                     },
                                     {
                                         "speaker":  12,
                                         "name":  "南巡使",
                                         "text":  "別裝模作樣了，我只求我不在的時候你們千萬不要亂來，千萬不要亂來....。"
                                     },
                                     {
                                         "speaker":  14,
                                         "name":  "飛霜",
                                         "text":  "再見再見！快快走吧！"
                                     },
                                     {
                                         "speaker":  12,
                                         "name":  "南巡使",
                                         "text":  "我不管了，出事你自己負責吧。"
                                     }
                                 ]
