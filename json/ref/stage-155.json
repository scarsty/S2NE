                       "raw_operands_semantics":  "unconfirmed",
                       "lines":  [
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "啊，妳們是誰？我在那裡？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "我是白志超，這些是我的夥伴們。"
                                     },
                                     {
                                         "speaker":  17,
                                         "name":  "秋月",
                                         "text":  "妳剛才是不是被人襲擊了？然後是不是有一些奚族的人救了妳？"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "啊，我想起來了....。她們人呢？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "她們已經先走了，妳還好嗎？沒受傷吧？"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "謝謝你們，我沒事。"
                                     },
                                     {
                                         "speaker":  14,
                                         "name":  "飛霜",
                                         "text":  "她們說妳是被一群小丑襲擊，這是真的嗎？"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "是真的，也許是國外派來的殺手吧，侍衛們都被打敗了....。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "侍衛....？妳是....？"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "咦？你們不是國內的人嗎？那還沒請教各位壯士來自何處，我好像還沒見過國內有如此勇士。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "呃....我們是來自北邊的....旅行者，和商隊一起來的。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "原來是遠方來的客人啊，那真不該失了禮數，那白先生打算往亞修斯一行嗎？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "嗯..是有這個打算。小姐您的芳名還沒請教呢？"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "哎....真是的，瞧我只顧得說，連名字都忘了講。我是奧帕兒，爹爹現任此地行政長官。剛才題到亞修斯城就是想邀請各位壯士到我家一遊，好款待諸位英雄的救命之恩....。"
                                     },
                                     {
                                         "speaker":  74,
                                         "name":  "護衛隊長",
                                         "text":  "小姐....請少說一些....。"
                                     },
                                     {
                                         "speaker":  12,
                                         "name":  "南巡使",
                                         "text":  "..喂....她就是領主的女兒耶，我們可不能暴露了身份....。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "白先生....？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "當然....當然，奧帕兒小姐，我們也正好打算要去亞修斯城，有妳們做伴路上一定更加有趣。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "白先生答應了？太好了，亞修斯城離此地約有兩天路程，讓我為各位恩人做響導吧。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "我們只是路過，算不上是恩人什麼的。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "這還是要謝謝你們的，請接受我的謝意吧。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "那裡，我們才要多謝妳。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "啊，我還要去看看侍衛們的傷，請等我一下。"
                                     }
                                 ]
                   },
                   {
                       "type":  6,
                       "completion_flag":  0,
                       "condition":  1,
                       "raw_operands":  {
                                            "offset_3":  13,
