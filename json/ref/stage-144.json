                                   },
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "咦？刑天，南巡使呢？"
                                     },
                                     {
                                         "speaker":  16,
                                         "name":  "刑天",
                                         "text":  "他說要私下調查，一個人走了。你身旁這個人又是誰？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "正好趁這個機會和大家介紹一下，這位是庫庫克，他告訴我們有關南方領軍事計劃的事情。"
                                     },
                                     {
                                         "speaker":  34,
                                         "name":  "庫庫克",
                                         "text":  "嘿，我是密盜庫庫克。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "在領主府內我們還碰到之前遇到的奚族少女娜塔莉雅，也提到相關的情報，看來消息應該不會有錯。"
                                     },
                                     {
                                         "speaker":  17,
                                         "name":  "秋月",
                                         "text":  "那我們是要強行殺進領主府嗎？"
                                     },
                                     {
                                         "speaker":  34,
                                         "name":  "庫庫克",
                                         "text":  "不必，不必，我知道有秘密通道可以直接通往事務官的辦公室。"
                                     },
                                     {
                                         "speaker":  18,
                                         "name":  "茱迪",
                                         "text":  "好極了，這樣就可以避免許多不必要的麻煩。"
                                     },
                                     {
                                         "speaker":  34,
                                         "name":  "庫庫克",
                                         "text":  "哼哼，跟我來吧。"
                                     }
                                 ]
