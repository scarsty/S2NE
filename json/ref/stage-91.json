    "name":  "領主府內",
    "briefing":  "",
    "objectives":  {
                       "victory":  "1.打敗宮廷大魔道。",
                       "defeat":  "白志超陣亡或娜塔莉雅陣亡。"
                   },
    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "這下麻煩惹大了！奚族的領頭，我們一起殺出去吧！"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "....好，我們各自負責一路吧。不過....。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "不過怎樣？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "我的名字叫做@@WA7,00D30@@娜塔莉雅@@RWRD@@，以後請你記住了。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "唉....一本正經的女人，我記著就是。"
                                     }
                                 ]
                   },
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  3
                                   },
                       "lines":  [
                                     {
                                         "speaker":  84,
                                         "name":  "宮廷大魔道",
                                         "text":  "哼....就是你們啊！衛兵們還不快上？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "快點動手，時間拖久了對我們不利！"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "....好吧，老大。"
                                     }
                                 ]
                   },
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  8
                                   },
                       "lines":  [
                                     {
                                         "speaker":  40,
                                         "name":  "柯莉特",
                                         "text":  "你們還沒走啊，哈哈哈，好極了！"
                                     },
                                     {
                                         "speaker":  84,
                                         "name":  "宮廷大魔道",
                                         "text":  "柯....柯將軍，這裡交給我來就可以了。"
                                     },
                                     {
                                         "speaker":  40,
                                         "name":  "柯莉特",
                                         "text":  "你要是辦得成，早在我來之前就拿下他們了。所以....還是交給我吧。"
                                     }
                                 ]
                   },
                   {
                       "type":  3,
                       "completion_flag":  13,
                       "condition":  2,
                       "role_id":  84,
                       "lines":  [
                                     {
                                         "speaker":  84,
                                         "name":  "宮廷大魔道",
                                         "text":  "......。"
                                     }
                                 ]
                   },
                   {
                       "type":  8,
                       "completion_flag":  11,
                       "condition":  2,
                       "raw_operands":  {
                                            "offset_3":  13,
                                            "offset_5":  1,
                                            "offset_7":  0,
                                            "offset_9":  0
                                        },
                       "raw_operands_semantics":  "unconfirmed",
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "原來各位的身手竟然如此精妙，剛才是我失禮了。請問諸位是來自何處？又為何得罪夏普那奸人？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "我們是來自北邊的....旅遊商人。才剛進宮就被伏擊，我們自己也莫名其妙，不知道那裡得罪了夏普。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "旅遊商人？好吧，我知道了。不知先生尊姓？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "我叫白志超，這些朋友都是生意上的夥伴們。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "很好..那現在敵人已除，白先生可以自便了。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "啊，妳是說我們要各走各路嗎？還是我們一起行動吧。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  0,
                       "branch_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "要自行尋路離開或是和旅遊商人一起走？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "還是各走各的吧。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "不，現在應該是同心協力的時候。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  14,
                       "condition":  1,
                       "branch_flag":  13,
                       "branch_value":  1,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "我們還有要事要辦，不能和白先生同行了。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "唉....妳....實在很有意思，我走便是。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "白先生這次義助之舉小妹銘感在心，我們就此別過。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "好吧，日後有機會再見！"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "再會。"
                                     }
                                 ]
                   },
