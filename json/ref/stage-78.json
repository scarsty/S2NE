    "name":  "突圍的選擇",
    "briefing":  "",
    "objectives":  {
                       "victory":  "1.娜塔莉雅抵達脫離點。*2.打敗所有的敵方部隊。",
                       "defeat":  "娜塔莉雅陣亡。"
                   },
    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  6,
                                         "name":  "黛西",
                                         "text":  "後面有騎兵隊....退路被截斷了！"
                                     },
                                     {
                                         "speaker":  5,
                                         "name":  "古斯塔夫",
                                         "text":  "前面也有大隊人馬，情況好像....不太對勁啊！"
                                     },
                                     {
                                         "speaker":  2,
                                         "name":  "穆爾",
                                         "text":  "往林中退後，不要和騎兵隊正面衝突，怎麼樣？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "不....現在不能打防禦戰，要各個擊破，往騎兵隊的方向突圍！"
                                     },
                                     {
                                         "speaker":  3,
                                         "name":  "泰普",
                                         "text":  "這次要玩真的啦。"
                                     }
                                 ]
                   },
                   {
                       "type":  3,
                       "completion_flag":  0,
                       "condition":  2,
                       "role_id":  74,
                       "lines":  [
                                     {
                                         "speaker":  74,
                                         "name":  "騎兵隊長",
                                         "text":  "怎..怎麼會輸給步兵....。"
                                     }
                                 ]
                   },
                   {
                       "type":  2,
                       "completion_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "快走，再有人來就沒力氣應付了。"
                                     },
                                     {
                                         "speaker":  5,
                                         "name":  "古斯塔夫",
                                         "text":  "那要往那裡去呢？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "回奚族的路上南方領一定會派出重兵把守，我們不能往回走。往亞修斯的路上多半也有援軍往來，只能往南北方向走。"
                                     },
                                     {
                                         "speaker":  4,
                                         "name":  "蘇",
                                         "text":  "大長老之前提過礦場之事，可以往南去採石場調查。"
                                     },
                                     {
                                         "speaker":  2,
                                         "name":  "穆爾",
                                         "text":  "北邊的罕泉鎮經常有商旅往來，我們在路上不容易被發現。"
                                     },
                                     {
                                         "speaker":  3,
                                         "name":  "泰普",
                                         "text":  "去那裡都好，快決定吧。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  0,
                       "branch_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "現在適合的目的地有兩處....。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "往北邊前往沙漠都市罕泉鎮。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "往南邊前往採石場調查情報。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  62,
                       "condition":  1,
                       "branch_flag":  13,
                       "branch_value":  1,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "我們往北邊去，到罕泉鎮去等候大長老的新任務。"
                                     },
                                     {
                                         "speaker":  4,
                                         "name":  "蘇",
                                         "text":  "這條路上會經過暹族的居地，要多加留意。"
                                     },
                                     {
                                         "speaker":  6,
                                         "name":  "黛西",
                                         "text":  "我也覺得奇怪，剛才包圍我們的人當中就有暹族的人，莫非....。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "也好，此行也可以順道調查暹族與南方領的關係。"
                                     },
                                     {
                                         "speaker":  2,
                                         "name":  "穆爾",
                                         "text":  "嗯。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  61,
                       "condition":  2,
                       "branch_flag":  13,
                       "branch_value":  2,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "我們往南走，儘量避開大路，到採石場去調查南方領的企圖。"
                                     },
                                     {
                                         "speaker":  5,
                                         "name":  "古斯塔夫",
                                         "text":  "這個礦場我以前去過，我知道怎麼走。"
                                     },
                                     {
                                         "speaker":  6,
                                         "name":  "黛西",
                                         "text":  "那就快走吧，留在這裡太危險了。"
                                     }
                                 ]
