                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  51,
                                         "name":  "野蠻戰士",
                                         "text":  "哈哈哈，村裡頭的小狗快出來投降，出來晚了就通通砍了！"
                                     },
                                     {
                                         "speaker":  55,
                                         "name":  "疾風盜賊團",
                                         "text":  "別在那裡大呼小叫的，是我們疾風盜賊團先到的，就算要屠村也輪不到你們這些蠻子！"
                                     },
                                     {
                                         "speaker":  53,
                                         "name":  "當地官兵",
                                         "text":  "住嘴！這些珠寶都是官府失落的，應該由我們接收保管才是。"
                                     },
                                     {
                                         "speaker":  130,
                                         "name":  "流民",
                                         "text":  "笑話，你們自己沒能力看好財寶，現在被大爺看到了就是我的！"
                                     },
                                     {
                                         "speaker":  90,
                                         "name":  "疾風盜賊團",
                                         "text":  "喂！你沒聽到是我們先來的嗎？若說先看到就屬誰，當然是....。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "那當然是這些村民的啦！"
                                     },
                                     {
                                         "speaker":  99,
                                         "name":  "獎金獵人",
                                         "text":  "....死人請不要開口說話。"
                                     },
                                     {
                                         "speaker":  96,
                                         "name":  "當地官兵",
                                         "text":  "既然見者有份，小妹建議大夥先讓這裡的證人都「閉嘴」，再來分財寶怎樣？"
                                     },
                                     {
                                         "speaker":  130,
                                         "name":  "流民",
                                         "text":  "小妮子說話夠爽快，大爺就跟你分了。"
                                     },
                                     {
                                         "speaker":  51,
                                         "name":  "野蠻戰士",
                                         "text":  "殺啊！殺啊！"
                                     },
                                     {
                                         "speaker":  55,
                                         "name":  "疾風盜賊團",
                                         "text":  "分就分！要分就出些力氣，不要只靠嘴巴！"
                                     },
                                     {
                                         "speaker":  99,
                                         "name":  "獎金獵人",
                                         "text":  "誰砍的多，誰就分的多，上吧！"
                                     }
                                 ]
