                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "....是該跟著前面的人追下去，還是直接前往賈府？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "繼續跟下去，看看有些什麼花樣。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "直接前往賈府，突擊大本營。"
                                     }
                                 ]
