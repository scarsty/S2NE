    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  13,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  35,
                                         "name":  "歐西德",
                                         "text":  "事情大致上是這樣的....。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "我瞭解了，這件事迫在眉梢，沒有比我們更適合來處理的人了。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "那麼你是同意了？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "當然....當然，旅遊商人本來就應該互相幫助的，不是嗎？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "好吧，旅遊商人，那我們現在也差不多該出發了，以免被南方領的特使團甩得太遠。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "慢，還沒決定我們各要負責那一路呢？"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  0,
                       "branch_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "奚族人馬決定要負責的目標是："
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "隊伍往赤子國追擊運金團。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "隊伍往軍港攔截軍事裝備。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  14,
                       "condition":  1,
                       "branch_flag":  13,
                       "branch_value":  1,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "赤子國的傭兵....嗯，這一路就讓我們來負責吧。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "那往軍港攔截一事就交給我吧。事成之後，我們約在亞修斯城西見面交換情報，再做打算。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "再好不過了，祝妳們能順利完成任務。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "你們也是，再見。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "下回見。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  15,
                       "condition":  2,
                       "branch_flag":  13,
                       "branch_value":  2,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "奧爾登軍港嗎？還沒去過呢，這一路就交給我們吧。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "那往赤子國追擊運金團一事就歸我吧。事成之後，我們約在亞修斯城西見面交換情報，再做打算。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "那就說定了，祝妳們能順利完成任務。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "你們也是，再見。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "下回見。"
                                     }
                                 ]
