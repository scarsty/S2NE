                       "branch_flag":  13,
                       "branch_value":  2,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "啊，真抱歉，我突然不想進去了，我走旁邊的小路可以吧？"
                                     },
