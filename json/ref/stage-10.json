                       "branch_flag":  13,
                       "branch_value":  1,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "我們是一般的善良百姓，不是什麼強盜土匪....。"
                                     },
                                     {
                                         "speaker":  70,
                                         "name":  "駐軍隊長",
                                         "text":  "是不是善良百姓等查過才知道，給我搜！"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  1,
