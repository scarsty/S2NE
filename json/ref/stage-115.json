                       "lines":  [
                                     {
                                         "speaker":  5,
                                         "name":  "古斯塔夫",
                                         "text":  "我們來遲了。"
                                     },
                                     {
                                         "speaker":  4,
                                         "name":  "蘇",
                                         "text":  "等等，你們看那邊正在上演鬧劇呢。"
                                     },
                                     {
                                         "speaker":  19,
                                         "name":  "夏普",
                                         "text":  "克雷布特里，我待你不薄，你怎麼可以這樣對我？"
                                     },
                                     {
                                         "speaker":  20,
                                         "name":  "克雷布特里",
                                         "text":  "....我....我只是應天而行，另投名主罷了，沒什麼大不了的。"
                                     },
                                     {
                                         "speaker":  21,
                                         "name":  "蘭瑟姆",
                                         "text":  "這種話你也說得出口？"
                                     },
                                     {
                                         "speaker":  20,
                                         "name":  "克雷布特里",
                                         "text":  "這裡沒有你說話的份！貝洛主子，我會把我知道的所有財產帳目明細和私產的隱藏地點、夏普的行政令符都呈供給您的，請您相信我的忠誠吧。"
                                     },
                                     {
                                         "speaker":  39,
                                         "name":  "貝洛元帥",
                                         "text":  "嗯....很好。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "克雷布特里，你這個卑鄙小人！"
                                     },
                                     {
                                         "speaker":  32,
                                         "name":  "法科爾",
                                         "text":  "奧帕兒小姐，自己小心。"
                                     }
                                 ]
                   },
