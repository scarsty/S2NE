                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "不行不行，獨自冒險才有意思，和商隊一起走就太無趣了。"
                                     },
                                     {
                                         "speaker":  50,
                                         "name":  "護衛隊長",
                                         "text":  "....你們真的要單獨穿越沙漠？好吧，請多加小心，惡鬼是很可怕的。"
                                     },
                                     {
                                         "speaker":  12,
                                         "name":  "南巡使",
                                         "text":  "這樣也好，知道我們行蹤的人會少些。"
                                     },
