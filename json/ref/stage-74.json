                   {
                       "type":  2,
                       "completion_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  5,
                                         "name":  "古斯塔夫",
                                         "text":  "小兵都解決了，接下來呢？"
                                     },
                                     {
                                         "speaker":  3,
                                         "name":  "泰普",
                                         "text":  "當然是殺進募兵所，大幹一場啦！"
                                     },
                                     {
                                         "speaker":  2,
                                         "name":  "穆爾",
                                         "text":  "不急吧，這樣拚太真刀真槍了，把守兵騙走就好了。"
                                     },
                                     {
                                         "speaker":  6,
                                         "name":  "黛西",
                                         "text":  "我沒意見，就看娜塔怎麼說？"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  0,
                       "branch_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "營救平民考慮所使用的戰略是....。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "照泰普說的，殺進募兵營挫盡敵方銳氣！"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "照穆爾說的，聲東擊西騙的敵方團團轉！"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  14,
                       "condition":  1,
                       "branch_flag":  13,
                       "branch_value":  1,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "這裡的守兵不算很強，不必弄巧了，直接殺進去救出平民就算完成任務了。"
                                     },
                                     {
                                         "speaker":  3,
                                         "name":  "泰普",
                                         "text":  "對對對，不用客氣，我來做先鋒吧。"
                                     },
                                     {
                                         "speaker":  6,
                                         "name":  "黛西",
                                         "text":  "真是急性子啊，唉。"
                                     }
                                 ]
