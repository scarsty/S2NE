    "name":  "賢者歐西德",
    "briefing":  "",
    "objectives":  {
                       "victory":  "1.打敗所有的獄守。",
                       "defeat":  "娜塔莉雅陣亡或任何一名待救援隊友陣亡。"
                   },
    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  26,
                                         "name":  "典獄長",
                                         "text":  "小心！有侵入者！"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "是這裡嗎？"
                                     },
                                     {
                                         "speaker":  27,
                                         "name":  "寶兒",
                                         "text":  "就是這裡，我看到爺爺了。"
                                     },
                                     {
                                         "speaker":  35,
                                         "name":  "歐西德",
                                         "text":  "寶兒！"
                                     }
                                 ]
                   },
                   {
                       "type":  3,
                       "completion_flag":  0,
                       "condition":  2,
                       "role_id":  26,
                       "lines":  [
                                     {
                                         "speaker":  26,
                                         "name":  "典獄長",
                                         "text":  "怎麼會....。"
                                     }
                                 ]
                   },
                   {
                       "type":  3,
                       "completion_flag":  0,
                       "condition":  2,
                       "role_id":  35,
                       "lines":  [
                                     {
                                         "speaker":  35,
                                         "name":  "歐西德",
                                         "text":  "寶兒....。"
                                     }
                                 ]
                   },
                   {
                       "type":  2,
                       "completion_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  27,
                                         "name":  "寶兒",
                                         "text":  "爺爺....你沒事太好了。"
                                     },
                                     {
                                         "speaker":  35,
                                         "name":  "歐西德",
                                         "text":  "啊..寶兒..這些人是妳的朋友嗎？"
                                     },
                                     {
                                         "speaker":  27,
                                         "name":  "寶兒",
                                         "text":  "是啊，這些大姐姐大哥哥都是寶兒的好朋友。"
                                     },
                                     {
                                         "speaker":  3,
                                         "name":  "泰普",
                                         "text":  "我那裡是....。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "寶兒的爺爺是因為何故被囚禁在此？"
                                     },
                                     {
                                         "speaker":  35,
                                         "name":  "歐西德",
                                         "text":  "啊....老兒慚愧，如果不是被各位搭救，就要讓夏普那廝給嘲笑了....。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "老爺爺不必心急，現在已經脫困，有什麼話可以慢慢說。"
                                     },
                                     {
                                         "speaker":  35,
                                         "name":  "歐西德",
                                         "text":  "聽我說。夏普早有併吞奚族就地稱王的念頭，只是迦納國一直提防他，讓他不敢有大動作。最近克雷布特里不時提供幾個軍事上的計劃於他，讓夏普頗想付諸行動。"
                                     },
                                     {
                                         "speaker":  4,
                                         "name":  "蘇",
                                         "text":  "那一方面的計劃？"
                                     },
                                     {
                                         "speaker":  35,
                                         "name":  "歐西德",
                                         "text":  "軍事上的。例如到赤子國去召募兩年前戰爭還沒散去的傭兵，與和海外的國家購買軍事裝備等....。"
                                     },
                                     {
                                         "speaker":  2,
                                         "name":  "穆爾",
                                         "text":  "南方領果然始終沒有放棄征服我族的野心。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "那麼....我們現在可以做什麼事呢？"
                                     },
                                     {
                                         "speaker":  35,
                                         "name":  "歐西德",
                                         "text":  "阻止這件計劃！不能讓傭兵與武器的買賣計劃成功，否則南方領一但在軍事上強盛了，會讓整個南方因衝突而長期混亂的。"
                                     },
                                     {
                                         "speaker":  2,
                                         "name":  "穆爾",
                                         "text":  "那這兩件事的交易之處是在那裡？"
                                     },
                                     {
                                         "speaker":  35,
                                         "name":  "歐西德",
                                         "text":  "與傭兵集團的交易是在赤子國境內，而武器的買賣在奧爾登軍港....是屬於南方領的境內....。"
                                     },
                                     {
                                         "speaker":  3,
                                         "name":  "泰普",
                                         "text":  "兩地相隔太遠了啦，這樣不可能同時去阻攔的。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "....也許有辦法。"
                                     },
                                     {
                                         "speaker":  4,
                                         "name":  "蘇",
                                         "text":  "妳是說....？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "我們可以找之前認識的@@WA7,00D2D@@旅行商人@@RWRD@@幫忙。"
                                     },
                                     {
                                         "speaker":  5,
                                         "name":  "古斯塔夫",
                                         "text":  "他們？我才不相信他們是真的旅行商人呢？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "我也不相信，所以才要去找他們談談。"
                                     },
                                     {
                                         "speaker":  35,
                                         "name":  "歐西德",
                                         "text":  "不管如何都事不宜遲，這兩路人馬隨時會出發，我們得快點。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "好，我們回城去找他們吧。"
                                     }
                                 ]
