    "name":  "奧帕兒",
    "briefing":  "",
    "objectives":  {
                       "victory":  "1.無。",
                       "defeat":  "白志超陣亡。"
                   },
    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  13,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "太謝謝你們了，還沒有請教各位壯士高名？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "壯士？喔....妳太過獎了，我是白志超，他們是我的伙伴。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "那還沒請教各位壯士來自何處，我好像還沒見過國內有如此勇士。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "呃....我們是來自北邊的....旅行者，和商隊一起來的。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "原來是遠方來的客人啊，那真不該失了禮數，那白先生打算往亞修斯一行嗎？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "嗯..是有這個打算。小姐您的芳名還沒請教呢？"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "哎....真是的，瞧我只顧得說，連名字都忘了講。我是奧帕兒，爹爹現任此地行政長官。剛才提到亞修斯城就是想邀請各位壯士到我家一遊，好款待諸位英雄的救命之恩....。"
                                     },
                                     {
                                         "speaker":  74,
                                         "name":  "護衛隊長",
                                         "text":  "小姐....請少說一些....。"
                                     },
                                     {
                                         "speaker":  12,
                                         "name":  "南巡使",
                                         "text":  "..喂....她就是領主的女兒耶，我們可不能暴露了身份....。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "白先生....？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "當然....當然，奧帕兒小姐，我們也正好打算要去亞修斯城，有妳們作伴路上一定更加有趣。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "白先生答應了？太好了，亞修斯城離此地約有兩天路程，讓我為各位恩人做嚮導吧。"
                                     },
                                     {
                                         "speaker":  74,
                                         "name":  "護衛隊長",
                                         "text":  "小姐既然決定了，請容我去打理行李。"
                                     },
                                     {
                                         "speaker":  22,
                                         "name":  "奧帕兒",
                                         "text":  "啊....我蒐集的香料....。對不起，失禮了，我還有事要處理，先告辭了。"
                                     }
                                 ]
                   },
                   {
                       "type":  6,
                       "completion_flag":  0,
                       "condition":  1,
                       "raw_operands":  {
                                            "offset_3":  13,
                                            "offset_5":  22,
                                            "offset_7":  74,
                                            "offset_9":  0
                                        },
                       "raw_operands_semantics":  "unconfirmed",
                       "lines":  [
                                     {
                                         "speaker":  12,
                                         "name":  "南巡使",
                                         "text":  "白老大，你想清楚了嗎？對方可是領主的女兒耶，我們不必深入虎穴吧？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "那有什麼不好？這樣省去多少力氣，直接就到亞修斯了。"
                                     },
                                     {
                                         "speaker":  12,
                                         "name":  "南巡使",
                                         "text":  "可是太冒險了吧....。"
                                     },
                                     {
                                         "speaker":  16,
                                         "name":  "刑天",
                                         "text":  "這樣吧，等會奧帕兒回來，你告訴她我們有部份人還有雜事，先行離去。你依然赴她的約，我和秋月、茱迪、南巡使從另一路趕往亞修斯，一路是明，一路是暗，任何一邊有事都可以互相照應。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "....嗯，就這麼辦。"
                                     }
                                 ]
