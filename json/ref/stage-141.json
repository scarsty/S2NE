                       "lines":  [
                                     {
                                         "speaker":  150,
                                         "name":  "女村民",
                                         "text":  "呼....沒事了。"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "男村民",
                                         "text":  "這樣看到就躲也不是辦法啊，是不是該遷居了？"
                                     },
                                     {
                                         "speaker":  13,
                                         "name":  "羅莎莉",
                                         "text":  "對不起，請問剛才是怎麼回事？"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "男村民",
                                         "text":  "你們是外地來的吧，難怪不知道「罕泉惡霸」賈得耶的惡行....。"
                                     },
                                     {
                                         "speaker":  150,
                                         "name":  "女村民",
                                         "text":  "噓....小聲點。"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "男村民",
                                         "text":  "（壓低聲音）這個惡霸喜歡指使手下魚肉鄉民，搜刮財物不說，有時還強奪少女，送到這渾蛋開設的妓院賣淫，真是天殺的(大聲)！"
                                     },
                                     {
                                         "speaker":  150,
                                         "name":  "女村民",
                                         "text":  "不要說了，快走吧。"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "男村民",
                                         "text":  "啊....我失言了，你就當做沒聽到吧，再見。"
                                     }
                                 ]
