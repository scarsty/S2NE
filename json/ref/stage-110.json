    "name":  "暹族的伏擊",
    "briefing":  "",
    "objectives":  {
                       "victory":  "1.打倒暹族的頭目。",
                       "defeat":  "娜塔莉雅陣亡或羅許陣亡。"
                   },
    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  69,
                                         "name":  "暹族頭目",
                                         "text":  "娜塔莉雅，你好啊。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "暹族的長老嗎？娜塔莉雅代表奚族向暹族問好。"
                                     },
                                     {
                                         "speaker":  69,
                                         "name":  "暹族頭目",
                                         "text":  "問好就不必了，不過妳蠻懂禮貌的，哼！"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "娜塔莉雅不知那裡得罪了暹族，請長老明言。"
                                     },
                                     {
                                         "speaker":  69,
                                         "name":  "暹族頭目",
                                         "text":  "在提那城的時候，妳們可傷了不少我們的人，這可不能抵賴吧。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "當時情況危急，我們只當來的都是南方領的人....而且是那些人先行動手的。"
                                     },
                                     {
                                         "speaker":  69,
                                         "name":  "暹族頭目",
                                         "text":  "好機靈的女娃啊，想把責任都推給南方領，以為這樣就沒事了嗎？告訴妳，現在我們已經和南方領合作了，妳們還是束手就擒吧！"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "....和南方領合作？這件事其它的長老知情嗎？還有....這次我們的行蹤你又是怎麼知道的？"
                                     },
                                     {
                                         "speaker":  69,
                                         "name":  "暹族頭目",
                                         "text":  "娜塔莉雅！看看這個人妳就會瞭解的....。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "羅許！"
                                     },
                                     {
                                         "speaker":  69,
                                         "name":  "暹族頭目",
                                         "text":  "我們逮到了他，他也只好乖乖地替我們送信了。"
                                     },
                                     {
                                         "speaker":  36,
                                         "name":  "羅許",
                                         "text":  "娜塔莉雅....各位....我對不起妳們....。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "那麼....你們打算就憑你們這些人來對付我們嗎？"
                                     },
                                     {
                                         "speaker":  69,
                                         "name":  "暹族頭目",
                                         "text":  "好猖狂的口氣！難道不夠嗎？我當然要親手殺掉妳！這樣我才有資格參加族長的競選！根本不需要用人質來威脅妳！"
                                     },
                                     {
                                         "speaker":  3,
                                         "name":  "泰普",
                                         "text":  "哈哈哈....就憑你，我都不敢這麼想了。"
                                     },
                                     {
                                         "speaker":  2,
                                         "name":  "穆爾",
                                         "text":  "看來暹族的人只適合作夢，老是說些不可能做到的事。"
                                     },
                                     {
                                         "speaker":  69,
                                         "name":  "暹族頭目",
                                         "text":  "哼....我本來還想留些活口的，現在....通通給我殺了！"
                                     }
                                 ]
                   },
                   {
                       "type":  3,
                       "completion_flag":  0,
                       "condition":  3,
                       "victim_role_id":  80,
                       "killer_role_id":  1,
                       "lines":  [
                                     {
                                         "speaker":  69,
                                         "name":  "暹族頭目",
                                         "text":  "看看妳到底有多少本事！看招！"
                                     }
