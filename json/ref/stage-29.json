    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "臭骨頭啊....以前好像碰過這種怪物。"
                                     },
                                     {
                                         "speaker":  16,
                                         "name":  "刑天",
                                         "text":  "....南方領一點武格都沒有嗎？老是請傭兵來助拳....唉。"
                                     },
                                     {
                                         "speaker":  17,
                                         "name":  "秋月",
                                         "text":  "斬妖除魔是習武者的本份，就讓我們來清理這些妖物吧！"
                                     }
                                 ]
                   },
                   {
                       "type":  2,
                       "completion_flag":  13
                   },
                   {
                       "type":  11,
                       "completion_flag":  0,
                       "condition":  12,
                       "raw_operands":  {
                                            "offset_3":  13,
                                            "offset_5":  10,
