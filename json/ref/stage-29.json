                                        },
                       "raw_operands_semantics":  "unconfirmed"
                   },
                   {
                       "type":  6,
                       "completion_flag":  0,
                       "condition":  2,
                       "raw_operands":  {
                                            "offset_3":  13,
                                            "offset_5":  149,
                                            "offset_7":  0,
                                            "offset_9":  65
                                        },
                       "raw_operands_semantics":  "unconfirmed"
                   },
                   {
                       "type":  7,
                       "completion_flag":  0,
                       "raw_operands":  {
                                            "offset_3":  13,
                                            "offset_5":  149,
                                            "offset_7":  6,
                                            "offset_9":  54
                                        },
                       "raw_operands_semantics":  "unconfirmed",
                       "lines":  [
                                     {
                                         "speaker":  149,
                                         "name":  "山野村夫",
                                         "text":  "這....這些惡鬼是你們打敗的嗎？"
                                     },
                                     {
                                         "speaker":  15,
                                         "name":  "艾文",
                                         "text":  "呵..小小妖魔鬼怪，何足掛齒？"
                                     },
                                     {
                                         "speaker":  14,
                                         "name":  "飛霜",
                                         "text":  "少臭美了，又不是你一個人打敗的。"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "山野村夫",
                                         "text":  "真的是你們打敗的！太好了！太謝謝你們了！"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "不客氣。請問有比官道更快通往奧爾登軍港的便道嗎？"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "山野村夫",
                                         "text":  "有的有的。往這裡切過去會經過沼澤地帶，比較辛苦但也快些。"
                                     },
                                     {
                                         "speaker":  17,
                                         "name":  "秋月",
                                         "text":  "那官道呢？"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "山野村夫",
                                         "text":  "最近這兩天有好多巡邏隊來來往往，會找路人麻煩，被碰上就倒楣了。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  0,
                       "branch_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "要往那一條路前進呢？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "循著官道繼續前進。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "抄小路進入沼澤地帶。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  14,
                       "condition":  1,
                       "branch_flag":  13,
                       "branch_value":  1,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "好，我們循著官道走下去，碰上巡邏隊就修理他們！"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "山野村夫",
                                         "text":  "使不得！使不得！他們很強的！"
                                     },
                                     {
                                         "speaker":  17,
                                         "name":  "秋月",
                                         "text":  "別擔心，我們也很強的。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "出發吧。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  15,
                       "condition":  2,
                       "branch_flag":  13,
                       "branch_value":  2,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "爭取一些時間吧，讓我們轉往沼澤地帶前進，看看能不能快些抵達軍港。"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "山野村夫",
                                         "text":  "請往林中走吧。"
                                     }
                                 ]
                   },
