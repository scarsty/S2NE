                                        },
                       "raw_operands_semantics":  "unconfirmed"
                   },
                   {
                       "type":  12,
                       "completion_flag":  0,
                       "condition":  25,
                       "raw_operands":  {
                                            "offset_3":  13,
                                            "offset_5":  4,
                                            "offset_7":  1,
                                            "offset_9":  0
                                        },
                       "raw_operands_semantics":  "unconfirmed"
                   },
                   {
                       "type":  2,
                       "completion_flag":  14,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "music_before":  5,
                                         "name":  "志超",
                                         "text":  "原來....妳們來亞修斯的目的和我們一樣嘛。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "是啊，一切盡在不言中。那麼....接下來你們還打算各走各的嗎？還是....合作一下？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "說明一下怎麼個合作法吧？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "這樓上就是事務官的辦公室了，裡面有一份南方領的「軍事計畫書」，夠清楚了吧。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  0,
                       "branch_flag":  14,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "....我瞭解了，讓我想想....。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "和奚族聯手一起攻進事務官的辦公室。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "先離開此地，會同隊友再作打算。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  15,
                       "condition":  1,
                       "branch_flag":  14,
                       "branch_value":  1,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "有意思，就讓我們聯手吧，南方領的人一定會吃驚的，呵呵呵....。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "同意了嗎？那我們動作要快，在領主府調集眾兵前完成任務。"
                                     }
                                 ]
                   },
                   {
                       "type":  14,
                       "completion_flag":  0,
