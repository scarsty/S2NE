    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  13,
                                         "name":  "羅莎莉",
                                         "text":  "怪....怪物！"
                                     },
                                     {
                                         "speaker":  14,
                                         "name":  "飛霜",
                                         "text":  "這是什麼鬼東西！真要命。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "先往後退吧，不要正面衝突。"
                                     }
                                 ]
                   },
                   {
                       "type":  1,
                       "completion_flag":  13,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  2
                                   },
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "啊！上次見過的奚族女孩，真是人生何處不相逢啊！"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "嗯，你是迦納國的劍客，白志超先生。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "看來我們的處境很類似嘛。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "....先解決怪物再說，如何？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "就這麼辦！"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "那先收拾下面的怪物。"
                                     }
                                 ]
                   },
                   {
                       "type":  12,
                       "completion_flag":  0,
                       "condition":  25,
                       "raw_operands":  {
                                            "offset_3":  13,
                                            "offset_5":  1,
                                            "offset_7":  1,
