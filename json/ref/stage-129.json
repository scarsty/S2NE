    "name":  "奚族聖地",
    "briefing":  "",
    "objectives":  {
                       "victory":  "1.打敗大魔導師西碧拉。",
                       "defeat":  "娜塔莉雅或白志超陣亡。"
                   },
    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  20,
                                         "name":  "克雷布特里",
                                         "text":  "呵呵呵，歡迎各位，在我即將返鄉的日子裡，還能見到各位一面，真是有緣啊。"
                                     },
                                     {
                                         "speaker":  15,
                                         "name":  "艾文",
                                         "text":  "你在胡說些什麼？"
                                     },
                                     {
                                         "speaker":  3,
                                         "name":  "泰普",
                                         "text":  "討厭的酸秀才，看我一斧頭把你劈了！"
                                     },
                                     {
                                         "speaker":  20,
                                         "name":  "克雷布特里",
                                         "text":  "愚蠢的人啊，我不屬於你們，也不屬於這個世界。算了....我說這麼多幹嘛，反正一切順利，我就快要回家了....。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "克雷布特里！告訴我，南方領之所以攻打奚族，是因為@@WA7,00D4D@@你@@RWRD@@的關係嗎？"
                                     },
                                     {
                                         "speaker":  20,
                                         "name":  "克雷布特里",
                                         "text":  "那又如何？貝洛也好，夏普也罷。當我告訴他們最新進武器的製作方法時，他們那裡能不起征伐的念頭？於是只要我說奚族的礦場有所需的原料，妳們的礦場就有麻煩了，然後我再說這裡能提供更棒更好的原料時，妳們兩邊能不打起來嗎？哈哈哈....而我也順順利利地來到這裡，這一切不是很完美嗎？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "既然你才是整個事件的元兇，那準備為所做的事情付出代價吧！"
                                     },
                                     {
                                         "speaker":  20,
                                         "music_after":  29,
                                         "name":  "克雷布特里",
                                         "text":  "這可不行，我還有事要辦，就讓西碧拉陪你們玩玩吧。"
                                     }
                                 ]
                   },
                   {
                       "type":  1,
                       "completion_flag":  13,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  2
                                   },
                       "lines":  [
                                     {
                                         "speaker":  20,
                                         "name":  "克雷布特里",
                                         "text":  "恕我不敬之罪，要先告辭了，各位請安心和我的手下們玩玩吧，保證沒有援軍，哈哈哈。"
                                     }
                                 ]
