    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  13,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  15,
                                         "name":  "艾文",
                                         "text":  "這是我們剛才拿到的東西。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "咦？這份文件是....南方領的@@WA7,00D6D@@軍事計畫書@@RWRD@@！"
                                     },
                                     {
                                         "speaker":  18,
                                         "name":  "茱迪",
                                         "text":  "裡面說些什麼？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "大致上的意思是南方領準備一筆資金，雇用赤子國附近的傭兵集團、與海外買進大量的武器兩個計劃同時進行....事成之後就要發動侵略戰爭了。"
                                     },
                                     {
                                         "speaker":  2,
                                         "name":  "穆爾",
                                         "text":  "人員加上裝備，好狠毒的計劃，現在我族的戰力本來就稍遜於南方領，如果讓他們計劃成功了，恐怕....恐怕有滅族之虞！"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "這件事牽連甚大，要及早準備，最好是現在就要採取行動！"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "對，這件事不能拖，也許負責這兩件任務的人已經出城了。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "既然不能留在城裡，不如出城去追擊那兩隻南方領的特遣隊，把這次南方領出兵前的準備工作都給破壞吧。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  0,
                       "branch_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "我也有這個意思，不如現在決定一下吧。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "隊伍往赤子國追擊運金團。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "隊伍往軍港攔截軍事裝備。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  14,
                       "condition":  1,
                       "branch_flag":  13,
                       "branch_value":  1,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "赤子國的傭兵....嗯，這一路就讓我們來負責吧。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "那往軍港攔截一事就交給我吧。事成之後，我們約在亞修斯城西見面交換情報，再做打算。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "再好不過了，祝妳們能順利完成任務。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "你們也是，再見。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "下回見。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  15,
                       "condition":  2,
                       "branch_flag":  13,
                       "branch_value":  2,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "奧爾登軍港嗎？還沒去過呢，這一路就交給我們吧。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "那往赤子國追擊運金團一事就歸我吧。事成之後，我們約在亞修斯城西見面交換情報，再做打算。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "那就說定了，祝妳們能順利完成任務。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "你們也是，再見。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "下回見。"
                                     }
