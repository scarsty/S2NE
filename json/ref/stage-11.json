                       "lines":  [
                                     {
                                         "speaker":  18,
                                         "name":  "茱迪",
                                         "text":  "想不到砸人家的屋子這般痛快。"
                                     },
                                     {
                                         "speaker":  13,
                                         "name":  "羅莎莉",
                                         "text":  "我們快溜吧，也許警衛快要到了。"
                                     },
                                     {
                                         "speaker":  14,
                                         "name":  "飛霜",
                                         "text":  "那多沒意思，還沒見到賈得耶本人呢。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  0,
                       "branch_flag":  14,
                       "lines":  [
                                     {
                                         "speaker":  15,
                                         "name":  "艾文",
                                         "text":  "老大，那我們現在是要殺進賈府裡面鬧個痛快呢，還是趕緊走人？"
                                     },
                                     {
                                         "speaker":  15,
                                         "name":  "艾文",
                                         "text":  "進屋子去找賈得耶晦氣。"
                                     },
                                     {
                                         "speaker":  15,
                                         "name":  "艾文",
                                         "text":  "早早開溜，見好就收。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  15,
                       "condition":  1,
                       "branch_flag":  14,
                       "branch_value":  1,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "連賈得耶都還沒看到就開溜不夠過癮，我們進去告訴他我們是來找碴的，看看他的表情。"
                                     },
                                     {
                                         "speaker":  14,
                                         "name":  "飛霜",
                                         "text":  "哈，我舉雙手贊成，不用客氣。"
                                     },
                                     {
                                         "speaker":  12,
                                         "name":  "南巡使",
                                         "text":  "唉，任務第一啊。"
                                     }
                                 ]
