                                     {
                                         "speaker":  34,
                                         "name":  "庫庫克",
                                         "text":  "這是我們剛才拿到的東西。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "咦？這份文件是....南方領的@@WA7,00D6D@@軍事計畫書@@RWRD@@！"
                                     },
                                     {
                                         "speaker":  18,
                                         "name":  "茱迪",
                                         "text":  "裡面說些什麼？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "大致上的意思是南方領準備一筆資金，雇用赤子國附近的傭兵集團、與海外買進大量的武器兩個計劃同時進行....事成之後就要發動侵略戰爭了。"
                                     },
                                     {
                                         "speaker":  2,
                                         "name":  "穆爾",
                                         "text":  "人員加上裝備，好狠毒的計劃，現在我族的戰力本來就稍遜於南方領，如果讓他們計劃成功了，恐怕....恐怕有滅族之虞！"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "這件事牽連甚大，要及早準備，最好是有地方可以詳談。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "我族在城中有個據點，就先到那裡去吧。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "好的。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "跟我來。"
                                     }
                                 ]
