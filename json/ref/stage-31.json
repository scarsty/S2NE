                       "branch_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "讓我想想啊....。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "先去追擊柯莉特。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "先消滅附近的敵軍。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  14,
                       "condition":  1,
                       "branch_flag":  13,
                       "branch_value":  1,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "擒賊先擒王，讓我們直搗柯莉特的本營吧！"
                                     },
                                     {
                                         "speaker":  150,
                                         "name":  "小村村民",
                                         "text":  "可是....。"
                                     },
                                     {
                                         "speaker":  18,
                                         "name":  "茱迪",
                                         "text":  "別擔心，這些小兵在群龍無首的情況下不能作惡的。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "走吧，讓我們破除南方領的計劃，讓柯莉特到不了赤子國。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  15,
