                       "branch_flag":  13,
                       "branch_value":  2,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "....好，先把小兵都打跑了再去追大將。"
                                     },
                                     {
                                         "speaker":  15,
                                         "name":  "艾文",
                                         "text":  "難道就這樣讓柯莉特跑了不成？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "這樣比較保險，至少不會有兩面作戰的可能，出發吧。"
                                     },
                                     {
                                         "speaker":  34,
                                         "name":  "庫庫克",
                                         "text":  "有仗打就好，我才不管什麼戰略呢！"
