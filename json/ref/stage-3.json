                       "lines":  [
                                     {
                                         "speaker":  16,
                                         "name":  "刑天",
                                         "text":  "這些傢伙是什麼人？"
                                     },
                                     {
                                         "speaker":  17,
                                         "name":  "秋月",
                                         "text":  "這批人原先都是臨時募來的傭兵部隊，準備趁城中混亂打劫財物，被茱迪和我給碰見了。"
                                     },
                                     {
                                         "speaker":  15,
                                         "name":  "艾文",
                                         "text":  "這計劃也未免太天真了，你們這些亡命之徒就算發了財也無處可去，何必和盜賊同夥自絕生路。"
                                     },
                                     {
                                         "speaker":  55,
                                         "name":  "盜賊",
                                         "text":  "告訴你也無妨，南邊的哨站....。"
                                     },
                                     {
                                         "speaker":  77,
                                         "name":  "盜賊首領",
                                         "text":  "住嘴！"
                                     },
                                     {
                                         "speaker":  55,
                                         "name":  "盜賊",
                                         "text":  "啊....是的老大。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "這倒有趣了，我沒看到有人啊？"
                                     },
                                     {
                                         "speaker":  18,
                                         "name":  "茱迪",
                                         "text":  "你們要小心，盜賊們的老大是隱形的，要貼身才看得到他。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "有趣極了，一個見不得人的老大，哈哈哈。"
                                     },
                                     {
                                         "speaker":  77,
                                         "name":  "盜賊首領",
                                         "text":  "哼！先殺了那兩個女的。"
                                     },
                                     {
                                         "speaker":  16,
                                         "music_after":  6,
                                         "name":  "刑天",
                                         "text":  "秋月，我來了！"
                                     }
                                 ]
