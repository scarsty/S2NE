    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  13,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  85,
                                         "name":  "南方領代表",
                                         "text":  "我，伊卡伯特代表南方領全體官兵宣誓：將停止對於奚族部落的侵略行為，儘速返回原先居地，對於長官錯誤領導所造成的損失與傷害，將在新王即位後予以賠償，且一切民生物資的管制都將解除，期待能回復兩族間和平的交往。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "我，娜塔莉雅代表奚族部落接受這份休戰協定。奚族同意讓南方領眾將兵返回原地不加攻擊，並遣返戰俘與軍旗等物。奚族很高興南方領諸人能夠醒悟並停止這次的侵略行為，期待未來的南方領政府有更好的回應。"
                                     },
                                     {
                                         "speaker":  15,
                                         "name":  "艾文",
                                         "text":  "喂！老大，換你了。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "我？兩族的休戰和我有啥關係？"
                                     },
                                     {
                                         "speaker":  14,
                                         "name":  "飛霜",
                                         "text":  "需要一個見證人啊！你身為迦那國任命的官員，又和奚族部落有密切關係，是最恰當的證人了！還不快去致詞？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "咳，嗯....很高興能在此發言....我....。"
                                     },
                                     {
                                         "speaker":  42,
                                         "name":  "清風",
                                         "text":  "咦？志超的聲音？志超你在這裡嗎？"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "清風！！！糟了！可不能被逮到！我們快溜！！！"
                                     }
                                 ]
                   },
