    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  40,
                                         "name":  "柯莉特",
                                         "text":  "哼，妳們果然來了。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "柯莉特，現在妳已經被我們追上，是戰是降就憑妳一句話吧。"
                                     },
                                     {
                                         "speaker":  40,
                                         "name":  "柯莉特",
                                         "text":  "笑話，我堂堂南方領柯大將軍，那有向蠻族投降的道理。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  ".....。"
                                     },
                                     {
                                         "speaker":  3,
                                         "name":  "泰普",
                                         "text":  "蠻族？就讓妳瞧瞧我們的厲害！"
                                     }
                                 ]
                   },
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  5
                                   },
                       "lines":  [
                                     {
                                         "speaker":  75,
                                         "name":  "雙龍城衛兵",
                                         "text":  "那裡來的盜賊敢在雙龍城械鬥？大公的侍衛隊就要到了！"
                                     },
                                     {
                                         "speaker":  40,
                                         "name":  "柯莉特",
                                         "text":  "赤子國的彥清風？太麻煩了，要在他到之前收拾掉妳們！"
                                     },
                                     {
                                         "speaker":  3,
                                         "name":  "泰普",
                                         "text":  "哈哈哈，真是妄想！"
                                     },
                                     {
                                         "speaker":  4,
                                         "name":  "蘇",
                                         "text":  "娜塔，柯莉特可能還有援兵。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "嗯....大家留意點。"
                                     }
                                 ]
                   },
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  7
                                   },
                       "lines":  [
                                     {
                                         "speaker":  42,
                                         "name":  "清風",
                                         "text":  "....南方領的柯將軍？不知我國那裡得罪了貴國？讓妳興師動眾派人到此？"
                                     },
                                     {
                                         "speaker":  151,
                                         "name":  "伊娃",
                                         "text":  "另一邊的人好像是奚族的人....。"
                                     },
                                     {
                                         "speaker":  40,
                                         "name":  "柯莉特",
                                         "text":  "（為今之計，只有盡速除掉娜塔莉雅，免得再生事非....。）"
                                     },
                                     {
                                         "speaker":  40,
                                         "name":  "柯莉特",
                                         "text":  "娜塔莉雅，準備接招吧！"
                                     },
                                     {
                                         "speaker":  42,
                                         "name":  "清風",
                                         "text":  "柯將軍再不停手，彥清風只有得罪了。"
                                     },
                                     {
                                         "speaker":  40,
                                         "name":  "柯莉特",
                                         "text":  "有本事就來試試吧，就不信你們魔法起家的赤子國能出什麼好戰士！"
                                     }
                                 ]
                   },
                   {
                       "type":  3,
                       "completion_flag":  0,
                       "condition":  2,
                       "role_id":  40,
                       "lines":  [
                                     {
                                         "speaker":  40,
                                         "name":  "柯莉特",
                                         "text":  "....今天妳們人多，下次再找妳們討回來。"
                                     }
                                 ]
                   },
                   {
                       "type":  2,
                       "completion_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  42,
                                         "name":  "清風",
                                         "text":  "各位可是來自奚族的勇士....。"
                                     },
                                     {
