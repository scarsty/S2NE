    "name":  "惡鬼攔路",
    "briefing":  "",
    "objectives":  {
                       "victory":  "1.消滅骷髏大帝。",
                       "defeat":  "娜塔莉雅陣亡。"
                   },
    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "骷髏兵團？南方領真是人才濟濟啊。"
                                     },
                                     {
                                         "speaker":  3,
                                         "name":  "泰普",
                                         "text":  "聖堂騎士派完了叫不死怪物迎戰，我看這兩支部隊才是一對兒。"
                                     },
                                     {
                                         "speaker":  35,
                                         "name":  "歐西德",
                                         "text":  "兩邊都是害人的兵器，留不得。"
                                     }
                                 ]
                   },
                   {
                       "type":  2,
                       "completion_flag":  13
                   },
                   {
                       "type":  11,
                       "completion_flag":  0,
                       "condition":  12,
                       "raw_operands":  {
                                            "offset_3":  13,
                                            "offset_5":  10,
                                            "offset_7":  0,
                                            "offset_9":  0
                                        },
                       "raw_operands_semantics":  "unconfirmed"
                   },
                   {
                       "type":  6,
                       "completion_flag":  0,
                       "condition":  2,
                       "raw_operands":  {
                                            "offset_3":  13,
                                            "offset_5":  149,
                                            "offset_7":  0,
                                            "offset_9":  65
                                        },
                       "raw_operands_semantics":  "unconfirmed"
                   },
                   {
                       "type":  7,
                       "completion_flag":  0,
                       "raw_operands":  {
                                            "offset_3":  13,
                                            "offset_5":  149,
                                            "offset_7":  6,
                                            "offset_9":  54
                                        },
                       "raw_operands_semantics":  "unconfirmed",
                       "lines":  [
                                     {
                                         "speaker":  149,
                                         "name":  "山野村夫",
                                         "text":  "這....這些惡鬼是你們打敗的嗎？"
                                     },
                                     {
                                         "speaker":  5,
                                         "name":  "古斯塔夫",
                                         "text":  "是啊，大家一起上就不會太難對付了。"
                                     },
                                     {
                                         "speaker":  6,
                                         "name":  "黛西",
                                         "text":  "捉妖打鬼我們很在行的，這點妖怪不算什麼。"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "山野村夫",
                                         "text":  "真的是你們打敗的！太好了！太謝謝你們了！"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "不客氣。請問有比官道更快通往奧爾登軍港的便道嗎？"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "山野村夫",
                                         "text":  "有的有的。往這裡切過去會經過沼澤地帶，比較辛苦但也快些。"
                                     },
                                     {
                                         "speaker":  2,
                                         "name":  "穆爾",
                                         "text":  "那官道呢？"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "山野村夫",
                                         "text":  "最近這兩天有好多巡邏隊來來往往，會找路人麻煩，被碰上就倒楣了。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  0,
                       "branch_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "要往那一條路前進呢？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "循著官道繼續前進。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "抄小路進入沼澤地帶。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  14,
                       "condition":  1,
                       "branch_flag":  13,
                       "branch_value":  1,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "好，我們循著官道走下去，碰上巡邏隊就修理他們！"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "山野村夫",
                                         "text":  "使不得！使不得！他們很強的！"
                                     },
                                     {
                                         "speaker":  2,
                                         "name":  "穆爾",
                                         "text":  "別擔心，我們也很強的。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "出發吧。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  15,
                       "condition":  2,
                       "branch_flag":  13,
                       "branch_value":  2,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "爭取一些時間吧，讓我們轉往沼澤地帶前進，看看能不能快些抵達軍港。"
                                     },
                                     {
                                         "speaker":  149,
                                         "name":  "山野村夫",
                                         "text":  "請往林中走吧。"
                                     }
                                 ]
                   },
