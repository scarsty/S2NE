    "events":  [
                   {
                       "type":  1,
                       "completion_flag":  0,
                       "trigger":  {
                                       "kind":  "turn",
                                       "turn":  1
                                   },
                       "lines":  [
                                     {
                                         "speaker":  76,
                                         "name":  "指揮官",
                                         "text":  "前面的奸細聽好，乖乖地丟下武器投降，我們可以考慮饒你們一命！"
                                     },
                                     {
                                         "speaker":  15,
                                         "name":  "艾文",
                                         "text":  "哈哈哈，真好笑。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "娜塔莉雅，妳有什麼打算？"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "我們先解決旁邊的弓箭手，再去對付那個狂傲的指揮官。"
                                     }
                                 ]
                   },
                   {
                       "type":  2,
                       "completion_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "music_before":  11,
                                         "name":  "娜塔莉雅",
                                         "text":  "這裡不能再待下去了，隨時都有可能會有衛兵來搜查。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "既然不能留在城裡，不如出城去追擊那兩支南方領的特遣隊，把這次南方領出兵前的準備工作都給破壞吧。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  0,
                       "branch_flag":  13,
                       "lines":  [
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "我也有這個意思，不如你選擇一路吧。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "往赤子國追擊運金團。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "往軍港攔截軍事裝備。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  14,
                       "condition":  1,
                       "branch_flag":  13,
                       "branch_value":  1,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "好久沒去赤子國了，想順道去看看，就讓我負責追擊運金團吧。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "那往軍港攔截一事就交給我吧。事成之後，我們約在亞修斯城西見面交換情報，再做打算。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "再好不過了，祝妳們能順利完成任務。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "你們也是，再見。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "下回見。"
                                     }
                                 ]
                   },
                   {
                       "type":  5,
                       "completion_flag":  15,
                       "condition":  2,
                       "branch_flag":  13,
                       "branch_value":  2,
                       "lines":  [
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "奧爾登軍港嗎？還沒去過呢，這一路就交給我們吧。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "那往赤子國追擊運金團一事交給我吧。事成之後，我們約在亞修斯城西見面交換情報，再做打算。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "那就說定了，祝妳們能順利完成任務。"
                                     },
                                     {
                                         "speaker":  1,
                                         "name":  "娜塔莉雅",
                                         "text":  "你們也是，再見。"
                                     },
                                     {
                                         "speaker":  11,
                                         "name":  "志超",
                                         "text":  "下回見。"
                                     }
                                 ]
