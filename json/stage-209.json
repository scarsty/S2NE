    "victory": "消滅所有敵軍。",
    "defeat": "白志超或娜塔莉雅陣亡。"
  },
  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 122,
          "name": "丑善",
          "text": "奚族的人嗎？"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "正是。"
        },
        {
          "speaker": 122,
          "name": "丑惡",
          "text": "我們奉命來收拾妳們！不用問原因了。"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "哼，先試試你的本事再說吧，好笑的小丑！"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 0,
      "lines": [
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "是誰派你們來的....？"
        },
        {
          "speaker": 122,
          "name": "丑善",
          "text": "......。"
        },
        {
          "speaker": 6,
          "name": "黛西",
          "text": "是夏普嗎？"
        },
        {
          "speaker": 122,
          "name": "丑善",
          "text": "......。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "讓我來吧，看著我。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "如果不是夏普，是貝洛將軍還是克雷布特里？"
        },
        {
          "speaker": 122,
          "name": "丑善",
          "text": "..是克雷布特里大人。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "為什麼？"
        },
        {
          "speaker": 122,
          "name": "丑善",
          "text": "大人....大人不希望妳們干擾到他的計劃....。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "什麼計劃？"
        },
        {
          "speaker": 122,
          "name": "丑善",
          "text": "我們也不知道。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "那你們來此之前還辦過那些事？"
        },
        {
          "speaker": 122,
          "name": "丑善",
          "text": "我們....我們去襲擊了夏普的女兒....奧帕兒。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "為什麼？"
        },
        {
          "speaker": 122,
          "name": "丑善",
          "text": "這樣夏普會認為是妳們幹的，才能夠引起衝突....。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "！！！"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "好了，忘了這回事吧。"
        }
      ]
    }
  ]
}
