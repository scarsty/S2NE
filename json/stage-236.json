      "lines": [
        {
          "speaker": 11,
          "name": "志超",
          "text": "......。"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "不好攻，這地勢太險要了。"
        },
        {
          "speaker": 15,
          "name": "艾文",
          "text": "那我們和柯莉特耗著如何？"
        },
        {
          "speaker": 17,
          "name": "秋月",
          "text": "恐怕不行，南方領的援軍隨時會趕到，耗下去不是辦法。"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "不錯，硬攻是唯一的對策，只是要多加小心謹慎，一次不要與太多敵軍交戰，步步為營才是。"
        },
        {
          "speaker": 18,
          "name": "茱迪",
          "text": "這種高度差的弓弩威力相當大，千萬當心！"
        },
        {
          "speaker": 34,
          "name": "庫庫克",
          "text": "說得這麼恐怖，卻又要打，矛盾！"
        }
      ]
    },
