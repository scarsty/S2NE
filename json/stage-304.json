  "objects": [],
  "name": "千里追劫",
  "briefing": "",
  "objectives": {
    "victory": "消滅所有敵軍。",
    "defeat": "白志超或娜塔莉雅陣亡。"
  },
  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 94,
          "name": "運金團副使",
          "text": "還沒來....還沒來....。"
        },
        {
          "speaker": 60,
          "name": "鐵血戰士",
          "text": "副使不用著急，柯將軍能力敵百人，不久就會趕到的。"
        },
        {
          "speaker": 94,
          "name": "運金團副使",
          "text": "算了吧，那些奚族蠻子的的厲害你又不是沒看到，柯將軍未必能回得來....。"
        },
        {
          "speaker": 60,
          "name": "鐵血戰士",
          "text": "副使妳....？"
        },
        {
          "speaker": 94,
          "name": "運金團副使",
          "text": "閉嘴！如果那些傭兵沒有在約好的時間出現的話，我才不要待在這裡呢！"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "聽到了沒？南方領的人就是這般沒有用！"
        },
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "柯莉特最起碼還有武將尊嚴，妳們就太差勁了！"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 94,
      "lines": [
        {
          "speaker": 94,
          "name": "運金團副使",
          "text": "哇....不是我想走這一趟的呀....！"
        }
      ]
    },
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 8
      },
      "lines": [
        {
          "speaker": 85,
          "name": "黑暗英雄",
          "text": "妳們兩邊那一方是打算出錢的人啊？"
        },
        {
          "speaker": 94,
          "name": "運金團副使",
          "text": "是我！是我！我是南方領的人！"
        },
        {
          "speaker": 85,
          "name": "黑暗英雄",
          "text": "....很好，就暫時為妳效勞吧。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 13,
      "lines": [
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "沒有必要多生事端，我們快走。"
        },
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "聽妳的。"
        }
      ]
    },
