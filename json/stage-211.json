  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 95,
          "name": "賈府保鑣",
          "text": "什麼人敢擅闖賈府? "
        },
        {
          "speaker": 12,
          "name": "南巡使",
          "text": "拜託你白老大，我們回去吧。就算要來，也該晚上從後門摸進去....。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "對付這種土豪劣紳不用客氣，直接殺進去事情就解決了。"
        },
        {
          "speaker": 12,
          "name": "南巡使",
          "text": "我的意思是....我們南來的消息要盡量封鎖，知道的人越少越好。這般大模大樣地殺進來，豈不是弄得人盡皆知....真是糟透了，唉！"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "我們現在是不是已經殺進來了？"
        },
        {
          "speaker": 12,
          "name": "南巡使",
          "text": "唉..是啊。"
        },
        {
          "speaker": 11,
          "music_after": 6,
          "name": "志超",
          "text": "那現在砍一個，知道的就少一個，加油吧！"
        },
        {
          "speaker": 147,
          "name": "祁師傅",
          "text": "......。"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 13,
      "condition": 2,
      "role_id": 147,
      "lines": [
        {
          "speaker": 147,
          "name": "祁師傅",
          "text": "老夫竟然敗在你們手裡....真不甘心。"
        }
      ]
    },
