          "name": "茱迪",
          "text": "想不到砸人家的屋子這般痛快。"
        },
        {
          "speaker": 13,
          "name": "羅莎莉",
          "text": "我們快溜吧，也許警衛快要到了。"
        },
        {
          "speaker": 14,
          "name": "飛霜",
          "text": "那多沒意思，還沒見到賈得耶本人呢。"
        }
      ]
