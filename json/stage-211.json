    },
    {
      "type": 11,
      "completion_flag": 0,
      "condition": 12,
      "raw_operands": {
        "offset_3": 14,
        "offset_5": 10,
        "offset_7": 0,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed"
    },
    {
      "type": 1,
      "completion_flag": 13,
      "trigger": {
        "kind": "turn",
        "turn": 10
      }
    },
    {
      "type": 8,
      "completion_flag": 7,
      "condition": 4,
      "raw_operands": {
        "offset_3": 13,
        "offset_5": 15,
        "offset_7": 46,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed",
      "lines": [
        {
          "speaker": 4,
          "name": "蘇",
          "text": "....？？？"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "這..這不是邪惡的力量啊，這到底是..？"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "妳們的計謀失敗了，還待在這裡做什麼？快離開聖地吧！"
        },
        {
          "speaker": 45,
          "name": "黑精靈",
          "text": "奇怪....？那裡錯了？預言不是這樣啊....？"
        }
      ]
    },
    {
      "type": 9,
      "completion_flag": 5,
      "lines": [
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "等等....。"
        }
      ]
    },
    {
      "type": 9,
      "completion_flag": 4,
      "lines": [
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "黑精靈退走了....。"
        },
        {
          "speaker": 3,
          "name": "泰普",
          "text": "小蘇啊，這到底是怎麼回事？莫名其妙。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "我也覺得奇怪....本來以為應該有個強大的魔靈被囚禁在這裡，剛剛那一瞬間還以為魔王脫困了。結果取而代之的是一種從來沒有接觸過的力量，我和黑精靈一樣覺得訝異。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "....我們回部落去向大長老報告這件事，事不宜遲。"
        }
      ]
    }
  ]
