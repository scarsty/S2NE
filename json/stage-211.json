  "events": [
    {
      "type": 1,
      "completion_flag": 14,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 2,
          "name": "穆爾",
          "text": "原來是這樣！是黑精靈在破壞聖地的平衡之氣。"
        },
        {
          "speaker": 4,
          "name": "蘇",
          "text": "娜塔....我們動作要快，我感覺到一股完全不熟悉的力量。"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "嗯，快去幫助守衛元素，不能讓黑精靈得逞。"
        }
      ]
    },
    {
      "type": 11,
      "completion_flag": 0,
      "condition": 11,
      "raw_operands": {
        "offset_3": 14,
        "offset_5": 10,
