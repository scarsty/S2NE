  "objects": [],
  "name": "神秘的訪客",
  "briefing": "",
  "objectives": {
    "victory": "消滅所有敵軍。",
    "defeat": "白志超或娜塔莉雅陣亡。"
  },
  "events": [
    {
      "type": 1,
      "completion_flag": 15,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 128,
          "name": "賈得耶",
          "text": "混蛋！他們跟進來了！都是你們害的！"
        },
        {
          "speaker": 99,
          "name": "賈府家將",
          "text": "......。"
        },
        {
          "speaker": 128,
          "name": "賈得耶",
          "text": "穆迪！快去消滅這些入侵者，如果你成功了，外面的女奴就都是你的了。"
        },
        {
          "speaker": 120,
          "name": "穆迪",
          "text": "@@WA3,00D10@@不....要！@@RWRD@@"
        },
        {
          "speaker": 128,
          "name": "賈得耶",
          "text": "你、說、什、麼！"
        },
        {
          "speaker": 120,
          "name": "穆迪",
          "text": "每次我辦完事你說過的話都打折，我不想再白忙一場了。"
        },
        {
          "speaker": 128,
          "name": "賈得耶",
          "text": "現在情況很緊急耶！別開玩笑了！"
        },
        {
          "speaker": 120,
          "name": "穆迪",
          "text": "Ｚ～Ｚ～啊，我睏了。"
        },
        {
          "speaker": 128,
          "name": "賈得耶",
          "text": "喂！喂！喂！"
        }
      ]
    },
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 2
      },
      "lines": [
        {
          "speaker": 128,
          "name": "賈得耶",
          "text": "好，那我把「吸血鬼之齒」給你，加上外面的女奴，怎麼樣？"
        },
        {
          "speaker": 120,
          "name": "穆迪",
          "text": "真的？這次你不能再食言了！否則....。"
        },
        {
          "speaker": 128,
          "name": "賈得耶",
          "text": "不會的....不會的....外面的女奴你要吸多少人都隨你，這次是真的....。"
        },
        {
          "speaker": 120,
          "music_after": 6,
          "name": "穆迪",
          "text": "好，那就讓我來吧，可愛的鮮血啊....。"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 13,
      "condition": 2,
      "role_id": 128,
      "lines": [
        {
          "speaker": 128,
          "name": "賈得耶",
          "text": "啊....黃金、珠寶和美玉....再見了....。"
        }
      ]
    },
    {
      "type": 8,
      "completion_flag": 11,
      "condition": 8,
      "raw_operands": {
        "offset_3": 13,
        "offset_5": 0,
        "offset_7": 0,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed"
    },
    {
      "type": 9,
      "completion_flag": 4,
      "condition": 2,
      "required_flags": [
        15
      ],
      "lines": [
        {
          "speaker": 120,
          "name": "穆迪",
          "text": "唉，真是糟透了，看來我得找個新主子了。"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 14,
      "condition": 2,
      "role_id": 120,
      "lines": [
        {
          "speaker": 120,
          "name": "穆迪",
          "text": "啊....真是遇人不淑，我又要回到棺材裡去休養了....。"
        }
      ]
    },
    {
      "type": 8,
      "completion_flag": 11,
      "condition": 8,
      "raw_operands": {
        "offset_3": 14,
        "offset_5": 0,
        "offset_7": 0,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed"
    },
    {
      "type": 9,
      "completion_flag": 4,
      "condition": 2,
      "required_flags": [
        15
      ],
      "lines": [
        {
          "speaker": 128,
          "name": "賈得耶",
          "text": "不！"
        }
      ]
    },
    {
      "type": 9,
      "completion_flag": 16,
      "condition": 7
    },
    {
      "type": 9,
      "completion_flag": 17,
