  "objects": [],
  "name": "北方合流篇-222-底座6",
  "briefing": "",
  "objectives": {
    "victory": "消滅所有敵軍。",
    "defeat": "白志超或娜塔莉雅陣亡。"
  },
  "events": [
    {
      "type": 1,
      "completion_flag": 0,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 50,
          "name": "護衛隊長",
          "text": "找到了，這裡就是沙盜的老巢。"
        },
        {
          "speaker": 12,
          "name": "南巡使",
          "text": "奇怪，人太少了點吧？"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "難道是埋伏？看來也不像？"
        },
        {
          "speaker": 13,
          "name": "羅莎莉",
          "text": "我有一種不祥的預感，大家小心為妙。"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 104,
      "lines": [
        {
          "speaker": 104,
          "name": "沙盜弩手",
          "text": "....你們來到這裡，老大卻去找商隊了，哈...。"
        }
      ]
    },
    {
      "type": 3,
      "completion_flag": 0,
      "condition": 2,
      "role_id": 104,
      "lines": [
        {
          "speaker": 130,
          "name": "沙盜戰士",
          "text": "就讓你們先高興一會吧，反正商隊就快完了....。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 0,
      "condition": 1,
      "lines": [
        {
          "speaker": 18,
          "music_before": 3,
          "name": "茱迪",
          "text": "難怪這裡的沙盜只有一點，原來....。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "這下子雖然把沙盜的老巢給掀了，商隊恐怕也要遭殃了....。"
        },
        {
          "speaker": 17,
          "name": "秋月",
          "text": "不管商隊是不是真的受到了攻擊，我們都應該趕回去。"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "不錯，商隊那邊應該還可以挺住一陣子，也許還來得及。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "那大夥快動身吧。"
        }
      ]
    }
  ]
}
