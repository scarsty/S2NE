  "events": [
    {
      "type": 1,
      "completion_flag": 13,
      "trigger": {
        "kind": "turn",
        "turn": 1
      },
      "lines": [
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "....接下來參加宴會的人是小姐的朋友，他們在罕泉鎮上擋住了刺客，才使小姐免於受到傷害....。"
        },
        {
          "speaker": 19,
          "name": "夏普",
          "text": "嗯，小夥子你做得不錯，我重重有賞。"
        },
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "爹！晚宴快開始了，讓我和朋友們一起用餐吧。"
        },
        {
          "speaker": 19,
          "name": "夏普",
          "text": "妳先進去招待賓客，為父要給你這些朋友一些賞賜，會花點時間。"
        },
        {
          "speaker": 22,
          "name": "奧帕兒",
          "text": "好的，那我先進去了。志超，等會記得來找我。"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "當然，我會記得的。"
        }
      ]
    },
    {
      "type": 7,
      "completion_flag": 0,
      "raw_operands": {
        "offset_3": 13,
        "offset_5": 22,
        "offset_7": 6,
        "offset_9": 21
      },
      "raw_operands_semantics": "unconfirmed"
    },
    {
      "type": 7,
