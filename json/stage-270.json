      "raw_operands_semantics": "unconfirmed",
      "lines": [
        {
          "speaker": 1,
          "music_before": 18,
          "name": "娜塔莉雅",
          "text": "夏普！識得我族的圖騰嗎！"
        },
        {
          "speaker": 19,
          "name": "夏普",
          "text": "奚族的人！今天混進來的刺客還真不少啊。"
        },
        {
          "speaker": 40,
          "name": "柯莉特",
          "text": "來多少都一樣！違背南方領利益的都得死！"
        },
        {
          "speaker": 1,
          "name": "娜塔莉雅",
          "text": "夏普！回答我，你為何派兵強佔我村莊與礦場！虐殺我老幼！"
        },
        {
          "speaker": 19,
          "name": "夏普",
          "text": "少囉唆了，我還要去參加晚宴呢，沒時間回答妳這些無中生有的鬼話。"
        },
        {
          "speaker": 5,
          "name": "古斯塔夫",
          "text": "和這種獨裁者沒什麼好說的，殺了他為族人報仇！"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "要打嗎？還是....。"
        }
      ]
    },
    {
      "type": 2,
      "completion_flag": 15,
      "lines": [
        {
          "speaker": 11,
          "name": "志超",
          "text": "快走吧，不要戀戰了....。"
        }
      ]
    },
