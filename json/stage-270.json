    },
    {
      "type": 12,
      "completion_flag": 0,
      "condition": 17,
      "raw_operands": {
        "offset_3": 13,
        "offset_5": 22,
        "offset_7": 0,
        "offset_9": 0
      },
      "raw_operands_semantics": "unconfirmed",
      "lines": [
        {
          "speaker": 19,
          "name": "夏普",
          "text": "進去了？"
        },
        {
          "speaker": 20,
          "music_after": 27,
          "name": "克雷布特里",
          "text": "是的，小姐已經進入用餐室了。"
        },
        {
          "speaker": 19,
          "name": "夏普",
          "text": "好，那可以動手了。"
        },
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "侍衛隊聽令！立即將這四人拿下！"
        },
        {
          "speaker": 11,
          "name": "志超",
          "text": "什麼？！"
        },
        {
          "speaker": 16,
          "name": "刑天",
          "text": "怎麼回事？"
        },
        {
          "speaker": 40,
          "name": "柯莉特",
          "text": "可憐的老鼠，被人識破了還不知道。"
        },
        {
          "speaker": 21,
          "name": "蘭瑟姆",
          "text": "......。"
        },
        {
          "speaker": 15,
          "name": "艾文",
          "text": "到底那裡錯了？"
        },
        {
          "speaker": 20,
          "name": "克雷布特里",
          "text": "侍衛隊不要猶豫，立即行動！"
        }
      ]
    },
    {
      "type": 1,
      "completion_flag": 14,
      "trigger": {
        "kind": "turn",
        "turn": 2
      }
    },
    {
      "type": 6,
